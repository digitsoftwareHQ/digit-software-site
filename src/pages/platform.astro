---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/shared/PageHero.astro";
import PlatformStack from "../components/shared/PlatformStack.astro";
import MissionControlMock from "../components/shared/MissionControlMock.astro";
import CerebroExplorer from "../components/shared/CerebroExplorer.astro";
import ClosingBand from "../components/shared/ClosingBand.astro";
import { SEO } from "../data/site";
import { KINDS } from "../data/cerebro-example";
import { CLASSES } from "../scripts/universe";
import type { StackLayer } from "../data/types";

const layers: StackLayer[] = [
  {
    id: "neo",
    name: "Neo",
    text: "Coordinates priorities, work, decisions, and what needs attention.",
    art: "orbit",
    href: "#neo",
    ariaLabel: "View Neo",
  },
  {
    id: "mission-control",
    name: "Mission Control",
    text: "Shows what is happening across the business and gives people a place to inspect and direct it.",
    art: "tiles",
    href: "#mission-control",
    ariaLabel: "View Mission Control",
  },
  {
    id: "cerebro",
    name: "Cerebro",
    text: "Keeps institutional knowledge connected and available across future work.",
    art: "cluster",
    href: "#cerebro",
    ariaLabel: "View Cerebro",
  },
  {
    id: "agents",
    name: "Specialized Agents",
    text: "Perform focused work across research, analysis, creation, review, monitoring, and other business functions.",
    art: "teams",
    href: "/technology#agents",
  },
  {
    id: "morpheus",
    name: "Morpheus",
    text: "Provides the execution environment that lets software carry work through approved systems and capabilities.",
    art: "rails",
    href: "/technology#execution",
    ariaLabel: "View execution layer",
  },
];

const neoItems = [
  { t: "Priorities", d: "Keep important work connected to what the business is trying to accomplish." },
  { t: "Coordination", d: "Bring different kinds of work together when an objective crosses systems or specialties." },
  { t: "Decisions", d: "Separate work that can continue autonomously from decisions that need a person." },
  { t: "Attention", d: "Surface the issues that actually matter instead of turning every event into an alert." },
];

const mcItems = [
  { t: "Company", d: "Understand the state of the organization and its businesses." },
  { t: "Operations", d: "See what is active, what has finished, and what is blocked." },
  { t: "Decisions", d: "Review the actions that need human judgment before they continue." },
  { t: "Financials", d: "Inspect revenue, expenses, profit, budgets, and financial activity where available." },
  { t: "Learning", d: "See what the business has learned from recent work and experiments." },
  { t: "System", d: "Understand whether the software and connected services are operating normally." },
];

const questions = [
  "Is everything running normally?",
  "What needs my attention?",
  "What is happening now?",
  "What changed?",
  "What does the system recommend?",
  "What did the business learn?",
];

const colorOf = (cls: string) => CLASSES.find((c) => c.key === cls)!.color;
---

<BaseLayout variant="home" title={SEO.platform.title} description={SEO.platform.description} path="/platform">
  <PageHero
    tone="platform"
    kicker="The Digit Platform"
    title="Software that's intelligent enough to run businesses."
    body={[
      "Digit's platform is built for software that does more than answer questions or wait for instructions.",
      "It can coordinate work, use specialized agents, keep track of what the business knows, act through connected systems, and surface the decisions that still need a person.",
    ]}
    primary={{ href: "#overview", label: "See the Platform" }}
    secondary={{ href: "/technology", label: "Our Technology" }}
  >
    <svg slot="backdrop" class="rings" viewBox="0 0 1440 700" preserveAspectRatio="xMidYMid slice">
      <g fill="none" stroke-width="1">
        <ellipse cx="1230" cy="470" rx="420" ry="150" stroke="rgba(110,190,255,0.09)" transform="rotate(-14 1230 470)" />
        <ellipse cx="1230" cy="470" rx="300" ry="104" stroke="rgba(110,190,255,0.12)" transform="rotate(-14 1230 470)" />
        <ellipse cx="1230" cy="470" rx="180" ry="62" stroke="rgba(127,227,255,0.2)" transform="rotate(-14 1230 470)" />
      </g>
      <circle cx="1230" cy="470" r="6" fill="#eafaff" />
      <circle cx="1230" cy="470" r="38" fill="rgba(39,196,255,0.1)" />
      <circle cx="1517" cy="402" r="4" fill="#36c6ff" />
      <circle cx="968" cy="533" r="3.5" fill="#8f86ff" />
      <circle cx="1390" cy="383" r="3" fill="#d6e2ff" />
    </svg>
  </PageHero>

  <section class="section overview" id="overview" aria-labelledby="overview-title">
    <div class="wrap">
      <div class="overview-grid">
        <div class="reveal">
          <p class="label kicker">How It Fits Together</p>
          <h2 class="h2" id="overview-title">The parts work together.</h2>
        </div>
        <div class="paras">
          <p class="reveal">Running a business requires more than a capable model or a collection of isolated agents.</p>
          <p class="reveal">
            Digit combines software for coordination, execution, knowledge, oversight, and specialized work into one operating
            platform.
          </p>
          <p class="reveal">
            Neo coordinates the operation. Mission Control gives people a view across the business. Cerebro keeps what the
            organization knows. Specialized agents perform focused work. Morpheus provides the execution environment beneath
            them.
          </p>
          <p class="reveal">Each part has a different job, but they work from the same operation.</p>
        </div>
      </div>
      <div class="stack-wrap">
        <PlatformStack layers={layers} />
      </div>
      <p class="label note reveal">Illustrative platform model. Not live operational data.</p>
    </div>
  </section>

  <section class="section neo" id="neo" aria-labelledby="neo-title">
    <div class="wrap grid-2">
      <div>
        <div class="reveal">
          <p class="label kicker">Neo</p>
          <h2 class="h2" id="neo-title">Neo coordinates the business.</h2>
        </div>
        <div class="paras">
          <p class="big reveal">Neo is Digit's operating executive.</p>
          <p class="reveal">
            Instead of treating every request as an isolated task, Neo works across the broader operation. Priorities, active
            work, business context, decisions, problems, and opportunities can stay connected as the company moves forward.
          </p>
          <p class="reveal">
            Neo can coordinate work across different parts of the business, bring the right problems to a person, and keep
            routine operations moving within the limits the business has set.
          </p>
          <p class="reveal">
            The goal is simple: people should be able to lead the company without personally coordinating every piece of work
            inside it.
          </p>
        </div>
      </div>

      <figure class="orbit reveal" style="--d: 120ms" aria-hidden="true">
        <svg viewBox="0 0 520 520">
          <defs>
            <radialGradient id="neo-core">
              <stop offset="0" stop-color="rgba(39,196,255,0.4)" />
              <stop offset="1" stop-color="rgba(39,196,255,0)" />
            </radialGradient>
          </defs>
          <circle cx="260" cy="260" r="170" fill="none" stroke="rgba(110,190,255,0.18)" />
          <circle cx="260" cy="260" r="110" fill="none" stroke="rgba(110,190,255,0.08)" stroke-dasharray="2 6" />
          <circle cx="260" cy="260" r="90" fill="url(#neo-core)" />
          {neoItems.map((item, i) => {
            const a = (i / neoItems.length) * Math.PI * 2 - Math.PI / 4;
            const x = 260 + Math.cos(a) * 170;
            const y = 260 + Math.sin(a) * 170;
            const lx = 260 + Math.cos(a) * 196;
            const ly = 260 + Math.sin(a) * 196 + (Math.sin(a) > 0 ? 22 : -12);
            return (
              <g class="node">
                <line x1="260" y1="260" x2={x} y2={y} />
                <circle class="pulse" r="3">
                  <animateMotion dur={`${3.4 + i * 0.6}s`} repeatCount="indefinite" path={`M 260 260 L ${x} ${y}`} />
                </circle>
                <circle cx={x} cy={y} r="9" />
                <text x={lx} y={ly} text-anchor={Math.cos(a) > 0 ? "start" : "end"}>
                  {item.t}
                </text>
              </g>
            );
          })}
          <circle cx="260" cy="260" r="16" class="neo-core" />
          <text class="neo-label" x="260" y="304" text-anchor="middle">NEO</text>
        </svg>
      </figure>
    </div>

    <div class="wrap">
      <ul class="items four">
        {
          neoItems.map((it, i) => (
            <li class="reveal" style={`--d: ${i * 70}ms`}>
              <h3>{it.t}</h3>
              <p>{it.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section mc" id="mission-control" aria-labelledby="mc-title">
    <div class="wrap">
      <div class="mc-head">
        <div class="reveal">
          <p class="label kicker">Mission Control</p>
          <h2 class="h2" id="mc-title">See the business as it operates.</h2>
        </div>
        <div class="paras">
          <p class="big reveal">Mission Control is the human interface to Digit's autonomous operations.</p>
          <p class="reveal">
            It brings the business into one place so people can understand what is happening without digging through agents,
            logs, tools, and disconnected systems.
          </p>
          <p class="reveal">
            The view can cover operations, businesses, financials, objectives, decisions, learning, company knowledge, and
            system health. When something needs a person, Mission Control should make the next step clear.
          </p>
        </div>
      </div>

      <ul class="items six">
        {
          mcItems.map((it, i) => (
            <li class="reveal" style={`--d: ${(i % 3) * 70}ms`}>
              <h3>{it.t}</h3>
              <p>{it.d}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="wrap mc-mock">
      <MissionControlMock variant="neo" />
    </div>

    <div class="wrap">
      <ul class="questions reveal">
        {questions.map((q) => <li>{q}</li>)}
      </ul>
    </div>
  </section>

  <section class="section cerebro" id="cerebro" aria-labelledby="cerebro-title">
    <div class="wrap">
      <div class="cerebro-head">
        <div class="reveal">
          <p class="label kicker">Cerebro</p>
          <h2 class="h2" id="cerebro-title">What the business knows, in one connected system.</h2>
        </div>
        <div class="paras">
          <p class="reveal">
            Businesses produce useful knowledge every day. Research, operating experience, decisions, evidence, procedures,
            results, and lessons often end up scattered across files and software.
          </p>
          <p class="big reveal">Cerebro gives Digit a place to keep that knowledge connected.</p>
          <p class="reveal">
            A record can retain what was learned, where it came from, how it relates to other knowledge, and where it may be
            useful again. That gives future work access to more than the current conversation or task.
          </p>
          <p class="reveal">Cerebro is built as institutional memory for an operating company.</p>
        </div>
      </div>

      <ul class="kinds">
        {
          KINDS.map((k, i) => (
            <li class="reveal" style={`--c: ${colorOf(k.cls)}; --d: ${(i % 3) * 70}ms`}>
              <h3>
                <i />
                {k.name}
              </h3>
              <p>{k.text}</p>
            </li>
          ))
        }
      </ul>

      <div class="explorer-wrap">
        <CerebroExplorer />
      </div>
    </div>
  </section>

  <ClosingBand
    headline="The platform is only useful if it can operate in the real world."
    body={[
      "The deeper engineering behind Digit covers execution, knowledge, integrations, governance, reliability, and the systems required to carry intelligent work across a business.",
    ]}
    cta={{ href: "/technology", label: "Explore the Technology" }}
  />
</BaseLayout>

<style>
  .rings {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 1080px) {
    .rings {
      opacity: 0.45;
    }
  }

  .paras p {
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.62;
    color: var(--ink-2);
    text-wrap: pretty;
    max-width: 36em;
  }

  .paras p + p {
    margin-top: 1em;
  }

  .paras .big {
    font-size: clamp(20px, 1.8vw, 24px);
    line-height: 1.4;
    font-weight: 500;
    font-stretch: 104%;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  /* ---- overview ---- */

  .overview-grid,
  .mc-head,
  .cerebro-head {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .stack-wrap {
    margin-top: clamp(56px, 7vw, 96px);
  }

  .note {
    margin-top: 28px;
    font-size: 11px;
  }

  /* ---- neo ---- */

  .neo {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(800px 600px at 75% 35%, rgba(23, 92, 200, 0.16), transparent 70%),
      var(--bg-0);
  }

  .neo .paras {
    margin-top: 28px;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .orbit {
    margin: 0;
  }

  .orbit svg {
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
    overflow: visible;
  }

  .node line {
    stroke: rgba(110, 190, 255, 0.28);
    stroke-width: 1;
  }

  .node circle:not(.pulse) {
    fill: var(--bg-2);
    stroke: #8f86ff;
    stroke-width: 1.5;
  }

  .node .pulse {
    fill: #7fe3ff;
    filter: drop-shadow(0 0 5px rgba(127, 227, 255, 0.9));
  }

  .node text {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 540;
    fill: var(--ink-2);
  }

  .neo-core {
    fill: #eafaff;
    filter: drop-shadow(0 0 12px rgba(127, 227, 255, 0.9));
  }

  .neo-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.3em;
    fill: var(--cyan-hi);
  }

  .items {
    list-style: none;
    margin: clamp(48px, 6vw, 80px) 0 0;
    padding: 0;
    display: grid;
    gap: clamp(20px, 3vw, 36px);
  }

  .items.four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .items.six {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .items li {
    padding-top: 18px;
    border-top: 1px solid var(--line-2);
  }

  .items h3,
  .kinds h3 {
    margin: 0;
    font-size: 20px;
    font-weight: 580;
    font-stretch: 108%;
    letter-spacing: -0.012em;
  }

  .items p,
  .kinds p {
    margin-top: 8px;
    font-size: 15.5px;
    color: var(--ink-2);
  }

  /* ---- mission control ---- */

  .mc {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(1000px 600px at 50% 60%, rgba(23, 92, 200, 0.14), transparent 70%),
      var(--bg-0);
  }

  .mc-mock {
    margin-top: clamp(56px, 7vw, 96px);
  }

  .questions {
    list-style: none;
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 28px;
  }

  .questions li {
    padding: 16px 0 16px 26px;
    position: relative;
    border-top: 1px solid var(--line);
    font-size: 17px;
    font-weight: 500;
    color: var(--ink);
  }

  .questions li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 25px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid var(--cyan);
    box-shadow: 0 0 8px rgba(39, 196, 255, 0.6);
  }

  /* ---- cerebro ---- */

  .cerebro {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(900px 600px at 40% 70%, rgba(30, 80, 190, 0.16), transparent 70%),
      radial-gradient(500px 400px at 85% 30%, rgba(139, 123, 255, 0.07), transparent 70%),
      var(--bg-0);
  }

  .kinds {
    list-style: none;
    margin: clamp(48px, 6vw, 80px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px clamp(20px, 3vw, 36px);
  }

  .kinds li {
    padding-top: 16px;
    border-top: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
  }

  .kinds h3 {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .kinds i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 10px var(--c);
  }

  .explorer-wrap {
    margin-top: clamp(48px, 6vw, 80px);
  }

  @media (max-width: 1080px) {
    .items.four {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .items.six,
    .kinds,
    .questions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .overview-grid,
    .mc-head,
    .cerebro-head,
    .grid-2 {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .items.four,
    .items.six,
    .kinds,
    .questions {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .node .pulse {
      display: none;
    }
  }
</style>
