---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/shared/PageHero.astro";
import PlatformStack from "../components/shared/PlatformStack.astro";
import MissionControlMock from "../components/shared/MissionControlMock.astro";
import CerebroExplorer from "../components/shared/CerebroExplorer.astro";
import ClosingBand from "../components/shared/ClosingBand.astro";
import { SEO } from "../data/site";
import { KINDS } from "../data/cerebro-example";
import { platform as c } from "../content/platform";
import { edit, parts } from "../content/schema";
import { CLASSES } from "../scripts/universe";
import type { StackLayer } from "../data/types";

const layers: StackLayer[] = [
  { id: "neo", ...c.layers.neo, art: "orbit", href: "#neo", ariaLabel: "View Neo" },
  { id: "mission-control", ...c.layers["mission-control"], art: "tiles", href: "#mission-control", ariaLabel: "View Mission Control" },
  { id: "cerebro", ...c.layers.cerebro, art: "cluster", href: "#cerebro", ariaLabel: "View Cerebro" },
  { id: "agents", ...c.layers.agents, art: "teams", href: "/technology#agents" },
  { id: "morpheus", ...c.layers.morpheus, art: "rails", href: "/technology#execution", ariaLabel: "View Morpheus" },
];

const colorOf = (cls: string) => CLASSES.find((k) => k.key === cls)!.color;
---

<BaseLayout variant="home" title={SEO.platform.title} description={SEO.platform.description} path="/platform">
  <PageHero tone="platform" copy={c.hero} primary="#overview" secondary="/technology">
    <svg slot="backdrop" class="rings" viewBox="0 0 1440 700" preserveAspectRatio="xMidYMid slice">
      <g fill="none" stroke-width="1">
        <ellipse cx="1230" cy="470" rx="420" ry="150" stroke="rgba(110,190,255,0.09)" transform="rotate(-14 1230 470)" />
        <ellipse cx="1230" cy="470" rx="300" ry="104" stroke="rgba(110,190,255,0.12)" transform="rotate(-14 1230 470)" />
        <ellipse cx="1230" cy="470" rx="180" ry="62" stroke="rgba(127,227,255,0.2)" transform="rotate(-14 1230 470)" />
      </g>
      <circle cx="1230" cy="470" r="6" fill="#eafaff" />
      <circle cx="1230" cy="470" r="38" fill="rgba(39,196,255,0.1)" />
      <circle cx="1517" cy="402" r="4" fill="#36c6ff" />
      <circle cx="968" cy="533" r="3.5" fill="#8f86ff" />
      <circle cx="1390" cy="383" r="3" fill="#d6e2ff" />
    </svg>
  </PageHero>

  <section class="section overview" id="overview" aria-labelledby="overview-title">
    <div class="wrap">
      <div class="overview-grid">
        <div class="reveal">
          <p class="label kicker" {...edit(c.overview.eyebrow, "eyebrow")}>{c.overview.eyebrow.text}</p>
          <h2 class="h2" id="overview-title" {...edit(c.overview.headline, "heading", ["size", "above", "below"])}>{c.overview.headline.text}</h2>
        </div>
        <div class="paras" {...edit(c.overview.body, "paragraphs", ["width", "above", "below"])}>
          {c.overview.body.text.map((p) => <p class="reveal">{p}</p>)}
        </div>
      </div>
      <div class="stack-wrap">
        <PlatformStack layers={layers} />
      </div>
      <p class="label note reveal" {...edit(c.overview.note, "caption")}>{c.overview.note.text}</p>
    </div>
  </section>

  <section class="section neo" id="neo" aria-labelledby="neo-title">
    <div class="wrap grid-2">
      <div>
        <div class="reveal">
          <p class="label kicker" {...edit(c.neo.eyebrow, "eyebrow")}>{c.neo.eyebrow.text}</p>
          <h2 class="h2" id="neo-title" {...edit(c.neo.headline, "heading", ["size", "above", "below"])}>{c.neo.headline.text}</h2>
        </div>
        <div class="paras">
          <p class="big reveal" {...edit(c.neo.lead, "text", ["size", "above", "below"])}>{c.neo.lead.text}</p>
          {parts(c.neo.body).map(({ text, part }) => <p class="reveal" {...edit(c.neo.body, "paragraphs", ["above", "below"], { part })}>{text}</p>)}
        </div>
      </div>

      <figure class="orbit reveal" style="--d: 120ms" aria-hidden="true">
        <svg viewBox="0 0 520 520">
          <defs>
            <radialGradient id="neo-core">
              <stop offset="0" stop-color="rgba(39,196,255,0.4)" />
              <stop offset="1" stop-color="rgba(39,196,255,0)" />
            </radialGradient>
          </defs>
          <circle cx="260" cy="260" r="170" fill="none" stroke="rgba(110,190,255,0.18)" />
          <circle cx="260" cy="260" r="110" fill="none" stroke="rgba(110,190,255,0.08)" stroke-dasharray="2 6" />
          <circle cx="260" cy="260" r="90" fill="url(#neo-core)" />
          {c.neo.items.map((item, i) => {
            const a = (i / c.neo.items.length) * Math.PI * 2 - Math.PI / 4;
            const x = 260 + Math.cos(a) * 170;
            const y = 260 + Math.sin(a) * 170;
            const lx = 260 + Math.cos(a) * 196;
            const ly = 260 + Math.sin(a) * 196 + (Math.sin(a) > 0 ? 22 : -12);
            return (
              <g class="node">
                <line x1="260" y1="260" x2={x} y2={y} />
                <circle class="pulse" r="3">
                  <animateMotion dur={`${3.4 + i * 0.6}s`} repeatCount="indefinite" path={`M 260 260 L ${x} ${y}`} />
                </circle>
                <circle cx={x} cy={y} r="9" />
                <text x={lx} y={ly} text-anchor={Math.cos(a) > 0 ? "start" : "end"} {...edit(item.title, "heading")}>
                  {item.title.text}
                </text>
              </g>
            );
          })}
          <circle cx="260" cy="260" r="16" class="neo-core" />
          <text class="neo-label" x="260" y="304" text-anchor="middle" {...edit(c.neo.diagramCore, "label")}>{c.neo.diagramCore.text}</text>
        </svg>
      </figure>
    </div>

    <div class="wrap">
      <ul class="items four">
        {
          c.neo.items.map((it, i) => (
            <li class="reveal" style={`--d: ${i * 70}ms`}>
              <h3 {...edit(it.title, "heading")}>{it.title.text}</h3>
              <p {...edit(it.body, "text")}>{it.body.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section mc" id="mission-control" aria-labelledby="mc-title">
    <div class="wrap">
      <div class="mc-head">
        <div class="reveal">
          <p class="label kicker" {...edit(c.missionControl.eyebrow, "eyebrow")}>{c.missionControl.eyebrow.text}</p>
          <h2 class="h2" id="mc-title" {...edit(c.missionControl.headline, "heading", ["size", "above", "below"])}>{c.missionControl.headline.text}</h2>
        </div>
        <div class="paras">
          <p class="big reveal" {...edit(c.missionControl.lead, "text", ["size", "above", "below"])}>{c.missionControl.lead.text}</p>
          {parts(c.missionControl.body).map(({ text, part }) => <p class="reveal" {...edit(c.missionControl.body, "paragraphs", ["above", "below"], { part })}>{text}</p>)}
        </div>
      </div>

      <ul class="items six">
        {
          c.missionControl.items.map((it, i) => (
            <li class="reveal" style={`--d: ${(i % 3) * 70}ms`}>
              <h3 {...edit(it.title, "heading")}>{it.title.text}</h3>
              <p {...edit(it.body, "text")}>{it.body.text}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="wrap mc-mock">
      <MissionControlMock variant="neo" caption={c.missionControl.caption} />
    </div>

    <div class="wrap">
      <ul class="questions reveal" {...edit(c.missionControl.questions, "list")}>
        {c.missionControl.questions.text.map((q) => <li>{q}</li>)}
      </ul>
    </div>
  </section>

  <section class="section cerebro" id="cerebro" aria-labelledby="cerebro-title">
    <div class="wrap">
      <div class="cerebro-head">
        <div class="reveal">
          <p class="label kicker" {...edit(c.cerebro.eyebrow, "eyebrow")}>{c.cerebro.eyebrow.text}</p>
          <h2 class="h2" id="cerebro-title" {...edit(c.cerebro.headline, "heading", ["size", "above", "below"])}>{c.cerebro.headline.text}</h2>
        </div>
        <div class="paras">
          <p class="reveal" {...edit(c.cerebro.intro, "text", ["above", "below"])}>{c.cerebro.intro.text}</p>
          <p class="big reveal" {...edit(c.cerebro.lead, "text", ["size", "above", "below"])}>{c.cerebro.lead.text}</p>
          {parts(c.cerebro.body).map(({ text, part }) => <p class="reveal" {...edit(c.cerebro.body, "paragraphs", ["above", "below"], { part })}>{text}</p>)}
        </div>
      </div>

      <ul class="kinds">
        {
          KINDS.map((k, i) => (
            <li class="reveal" style={`--c: ${colorOf(k.cls)}; --d: ${(i % 3) * 70}ms`}>
              <h3 {...edit(c.cerebro.kinds[k.cls].title, "heading")}>
                <i />
                {c.cerebro.kinds[k.cls].title.text}
              </h3>
              <p {...edit(c.cerebro.kinds[k.cls].body, "text")}>{c.cerebro.kinds[k.cls].body.text}</p>
            </li>
          ))
        }
      </ul>

      <div class="explorer-wrap">
        <CerebroExplorer note={c.cerebro.explorerNote} />
      </div>
    </div>
  </section>

  <ClosingBand copy={c.closing} cta="/technology" />
</BaseLayout>

<style>
  .rings {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 1080px) {
    .rings {
      opacity: 0.45;
    }
  }

  .paras p {
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.62;
    color: var(--ink-2);
    text-wrap: pretty;
    max-width: 36em;
  }

  .paras p + p {
    margin-top: 1em;
  }

  .paras .big {
    --fs: clamp(20px, 1.8vw, 24px);
    font-size: var(--fs);
    line-height: 1.4;
    font-weight: 500;
    font-stretch: 104%;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  /* ---- overview ---- */

  .overview-grid,
  .mc-head,
  .cerebro-head {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .stack-wrap {
    margin-top: clamp(56px, 7vw, 96px);
  }

  .note {
    margin-top: 28px;
    font-size: 11px;
  }

  /* ---- neo ---- */

  .neo {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(800px 600px at 75% 35%, rgba(23, 92, 200, 0.16), transparent 70%),
      var(--bg-0);
  }

  .neo .paras {
    margin-top: 28px;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .orbit {
    margin: 0;
  }

  .orbit svg {
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
    overflow: visible;
  }

  .node line {
    stroke: rgba(110, 190, 255, 0.28);
    stroke-width: 1;
  }

  .node circle:not(.pulse) {
    fill: var(--bg-2);
    stroke: #8f86ff;
    stroke-width: 1.5;
  }

  .node .pulse {
    fill: #7fe3ff;
    filter: drop-shadow(0 0 5px rgba(127, 227, 255, 0.9));
  }

  .node text {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 540;
    fill: var(--ink-2);
  }

  .neo-core {
    fill: #eafaff;
    filter: drop-shadow(0 0 12px rgba(127, 227, 255, 0.9));
  }

  .neo-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.3em;
    fill: var(--cyan-hi);
  }

  .items {
    list-style: none;
    margin: clamp(48px, 6vw, 80px) 0 0;
    padding: 0;
    display: grid;
    gap: clamp(20px, 3vw, 36px);
  }

  .items.four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .items.six {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .items li {
    padding-top: 18px;
    border-top: 1px solid var(--line-2);
  }

  .items h3,
  .kinds h3 {
    margin: 0;
    font-size: 20px;
    font-weight: 580;
    font-stretch: 108%;
    letter-spacing: -0.012em;
  }

  .items p,
  .kinds p {
    margin-top: 8px;
    font-size: 15.5px;
    color: var(--ink-2);
  }

  /* ---- mission control ---- */

  .mc {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(1000px 600px at 50% 60%, rgba(23, 92, 200, 0.14), transparent 70%),
      var(--bg-0);
  }

  .mc-mock {
    margin-top: clamp(56px, 7vw, 96px);
  }

  .questions {
    list-style: none;
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 28px;
  }

  .questions li {
    padding: 16px 0 16px 26px;
    position: relative;
    border-top: 1px solid var(--line);
    font-size: 17px;
    font-weight: 500;
    color: var(--ink);
  }

  .questions li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 25px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid var(--cyan);
    box-shadow: 0 0 8px rgba(39, 196, 255, 0.6);
  }

  /* ---- cerebro ---- */

  .cerebro {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(900px 600px at 40% 70%, rgba(30, 80, 190, 0.16), transparent 70%),
      radial-gradient(500px 400px at 85% 30%, rgba(139, 123, 255, 0.07), transparent 70%),
      var(--bg-0);
  }

  .kinds {
    list-style: none;
    margin: clamp(48px, 6vw, 80px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px clamp(20px, 3vw, 36px);
  }

  .kinds li {
    padding-top: 16px;
    border-top: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
  }

  .kinds h3 {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .kinds i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 10px var(--c);
  }

  .explorer-wrap {
    margin-top: clamp(48px, 6vw, 80px);
  }

  @media (max-width: 1080px) {
    .items.four {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .items.six,
    .kinds,
    .questions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .overview-grid,
    .mc-head,
    .cerebro-head,
    .grid-2 {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .items.four,
    .items.six,
    .kinds,
    .questions {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .node .pulse {
      display: none;
    }
  }
</style>
