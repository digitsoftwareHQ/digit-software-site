---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import HomeCompany from "../components/home/HomeCompany.astro";
import BusinessesPreview from "../components/home/BusinessesPreview.astro";
import PlatformSection from "../components/home/PlatformSection.astro";
import TechnologyPreview from "../components/home/TechnologyPreview.astro";
import Governance from "../components/home/Governance.astro";
import Loop from "../components/home/Loop.astro";
import ContactCTA from "../components/shared/ContactCTA.astro";
import { SEO } from "../data/site";
import { home } from "../content/home";
---

<BaseLayout variant="home" path="/" title={SEO.home.title} description={SEO.home.description}>
  <Hero />
  <HomeCompany />
  <BusinessesPreview />
  <PlatformSection />
  <TechnologyPreview />
  <Governance />
  <Loop />
  <ContactCTA copy={home.contact} secondary="/businesses" />
</BaseLayout>
