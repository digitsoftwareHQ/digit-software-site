---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/shared/PageHero.astro";
import BusinessEmblem from "../components/shared/BusinessEmblem.astro";
import CycleDiagram from "../components/shared/CycleDiagram.astro";
import ClosingBand from "../components/shared/ClosingBand.astro";
import ContactCTA from "../components/shared/ContactCTA.astro";
import { BUSINESSES } from "../data/businesses";
import { SEO } from "../data/site";
---

<BaseLayout variant="home" title={SEO.businesses.title} description={SEO.businesses.description} path="/businesses">
  <PageHero
    tone="businesses"
    kicker="Our Businesses"
    title="Businesses built to operate differently."
    body={[
      "Digit owns and manages a portfolio of businesses across e-commerce, media, marketing, web solutions, and software development.",
      "The businesses are different. The operating idea behind them is the same: use software to take on more of the work, learn from what happens, and improve how the business operates over time.",
    ]}
    primary={{ href: "#portfolio", label: "Explore the Portfolio" }}
    secondary={{ href: "/platform", label: "Our Platform" }}
  />

  <section class="section portfolio" id="portfolio" aria-labelledby="portfolio-title">
    <div class="wrap grid">
      <div>
        <div class="reveal">
          <p class="label kicker">The Portfolio</p>
          <h2 class="h2" id="portfolio-title">Operating businesses changes how we build software.</h2>
        </div>
        <div class="paras">
          <p class="big reveal">A business gives the technology real work to do.</p>
          <p class="reveal">
            Markets move. Customers behave in unexpected ways. Processes break. New opportunities appear. Some ideas work and
            others do not.
          </p>
          <p class="reveal">
            Operating our own businesses gives Digit a direct way to learn from those conditions. The software has to deal with
            the same uncertainty, repetition, coordination, and decision-making that exists inside any real operation.
          </p>
          <p class="reveal">What we learn in the portfolio can shape what we build next.</p>
        </div>
      </div>
      <div class="cycle-wrap reveal" style="--d: 120ms">
        <CycleDiagram />
        <p class="cycle-note">
          The portfolio gives the technology somewhere real to work. The results feed back into the software.
        </p>
      </div>
    </div>
  </section>

  {
    BUSINESSES.map((b, i) => (
      <section class:list={["section", "area", { flip: i % 2 === 1 }]} id={b.id} aria-labelledby={`${b.id}-title`} style={`--h: ${b.hue}`}>
        <div class="wrap area-grid">
          <div class="area-copy">
            <p class="label kicker reveal">{b.eyebrow}</p>
            <h2 class="h2 reveal" id={`${b.id}-title`}>{b.headline}</h2>
            <div class="paras">
              {b.body.map((p) => (
                <p class="reveal">{p}</p>
              ))}
            </div>
            <div class="work reveal">
              <p class="label">Areas of Work</p>
              <ul>
                {b.areas.map((w) => (
                  <li>{w}</li>
                ))}
              </ul>
            </div>
          </div>
          <div class="tile reveal" style="--d: 120ms" aria-hidden="true">
            <BusinessEmblem id={b.id} hue={b.hue} size={220} />
          </div>
        </div>
      </section>
    ))
  }

  <ClosingBand
    headline="The businesses give the technology something real to prove."
    body={[
      "The portfolio is where ideas about autonomous operations meet deadlines, customers, costs, competition, and measurable results.",
      "Those lessons go back into the systems Digit builds.",
    ]}
    cta={{ href: "/technology", label: "Explore the Technology" }}
  />

  <ContactCTA
    headline="Interested in Digit's businesses?"
    body="For portfolio, partnership, or company inquiries, get in touch."
    secondary={{ href: "/company", label: "About Digit" }}
  />
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .paras {
    margin-top: 28px;
  }

  .paras p {
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.62;
    color: var(--ink-2);
    text-wrap: pretty;
    max-width: 36em;
  }

  .paras p + p {
    margin-top: 1em;
  }

  .paras .big {
    font-size: clamp(20px, 1.8vw, 24px);
    line-height: 1.4;
    font-weight: 500;
    font-stretch: 104%;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .cycle-note {
    margin: 4px auto 0;
    max-width: 26em;
    text-align: center;
    font-size: 15px;
    color: var(--ink-3);
  }

  .area {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(700px 500px at 78% 50%, color-mix(in srgb, var(--h) 9%, transparent), transparent 70%),
      var(--bg-0);
  }

  .area.flip {
    background:
      radial-gradient(700px 500px at 22% 50%, color-mix(in srgb, var(--h) 9%, transparent), transparent 70%),
      var(--bg-0);
  }

  .area-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .flip .area-grid {
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
  }

  .flip .area-copy {
    order: 2;
  }

  .area .kicker::before {
    background: linear-gradient(90deg, var(--h), transparent);
  }

  .area .h2 {
    font-size: clamp(32px, 3.6vw, 52px);
    max-width: 16em;
  }

  .area .paras p {
    font-size: 17px;
  }

  .work {
    margin-top: 32px;
  }

  .work ul {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 24px;
    max-width: 560px;
  }

  .work li {
    position: relative;
    padding: 10px 0 10px 18px;
    border-top: 1px solid var(--line);
    font-size: 15px;
    color: var(--ink);
  }

  .work li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 18px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--h);
    box-shadow: 0 0 8px var(--h);
  }

  .tile {
    position: relative;
    aspect-ratio: 1;
    max-width: 360px;
    width: 100%;
    margin-inline: auto;
    display: grid;
    place-items: center;
    border-radius: 28px;
    border: 1px solid color-mix(in srgb, var(--h) 28%, transparent);
    background:
      radial-gradient(closest-side, color-mix(in srgb, var(--h) 14%, transparent), transparent),
      linear-gradient(rgba(60, 170, 255, 0.03) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, rgba(60, 170, 255, 0.03) 1px, transparent 1px) 0 0 / 32px 32px,
      rgba(4, 9, 20, 0.6);
    box-shadow: var(--shadow-float);
  }

  .tile :global(.emblem) {
    width: 58%;
    height: auto;
  }

  @media (max-width: 900px) {
    .grid,
    .area-grid,
    .flip .area-grid {
      grid-template-columns: 1fr;
    }

    .flip .area-copy {
      order: 0;
    }

    .tile {
      max-width: 240px;
      margin: 8px 0 0;
    }
  }

  @media (max-width: 560px) {
    .work ul {
      grid-template-columns: 1fr;
    }

    .tile {
      max-width: 200px;
    }
  }
</style>
