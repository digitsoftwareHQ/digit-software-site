---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/shared/PageHero.astro";
import BusinessEmblem from "../components/shared/BusinessEmblem.astro";
import CycleDiagram from "../components/shared/CycleDiagram.astro";
import ClosingBand from "../components/shared/ClosingBand.astro";
import ContactCTA from "../components/shared/ContactCTA.astro";
import { BUSINESSES } from "../data/businesses";
import { SEO } from "../data/site";
import { businesses as c } from "../content/businesses";
import { edit, parts } from "../content/schema";
---

<BaseLayout variant="home" title={SEO.businesses.title} description={SEO.businesses.description} path="/businesses">
  <PageHero tone="businesses" copy={c.hero} primary="#portfolio" secondary="/platform" />

  <section class="section portfolio" id="portfolio" aria-labelledby="portfolio-title">
    <div class="wrap grid">
      <div>
        <div class="reveal">
          <p class="label kicker" {...edit(c.portfolio.eyebrow, "eyebrow")}>{c.portfolio.eyebrow.text}</p>
          <h2 class="h2" id="portfolio-title" {...edit(c.portfolio.headline, "heading", ["size", "above", "below"])}>{c.portfolio.headline.text}</h2>
        </div>
        <div class="paras">
          <p class="big reveal" {...edit(c.portfolio.lead, "text", ["size", "above", "below"])}>{c.portfolio.lead.text}</p>
          {parts(c.portfolio.body).map(({ text, part }) => <p class="reveal" {...edit(c.portfolio.body, "paragraphs", ["above", "below"], { part })}>{text}</p>)}
        </div>
      </div>
      <div class="cycle-wrap reveal" style="--d: 120ms">
        <CycleDiagram />
        <p class="cycle-note" {...edit(c.portfolio.diagramNote, "caption")}>
          {c.portfolio.diagramNote.text}
        </p>
      </div>
    </div>
  </section>

  {
    BUSINESSES.map((b, i) => {
      const a = c.areas[b.id];
      return (
        <section class:list={["section", "area", { flip: i % 2 === 1 }]} id={b.id} aria-labelledby={`${b.id}-title`} style={`--h: ${b.hue}`}>
          <div class="wrap area-grid">
            <div class="area-copy">
              <p class="label kicker reveal" {...edit(a.eyebrow, "eyebrow")}>{a.eyebrow.text}</p>
              <h2 class="h2 reveal" id={`${b.id}-title`} {...edit(a.headline, "heading", ["size", "width", "above", "below"])}>{a.headline.text}</h2>
              <div class="paras" {...edit(a.body, "paragraphs", ["above", "below"])}>
                {a.body.text.map((p) => (
                  <p class="reveal">{p}</p>
                ))}
              </div>
              <div class="work reveal">
                <p class="label" {...edit(c.workLabel, "label")}>{c.workLabel.text}</p>
                <ul {...edit(a.work, "list")}>
                  {a.work.text.map((w) => (
                    <li>{w}</li>
                  ))}
                </ul>
              </div>
            </div>
            <div class="tile reveal" style="--d: 120ms" aria-hidden="true">
              <BusinessEmblem id={b.id} hue={b.hue} size={220} />
            </div>
          </div>
        </section>
      );
    })
  }

  <ClosingBand copy={c.closing} cta="/technology" />

  <ContactCTA copy={c.contact} secondary="/company" />
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .paras {
    margin-top: 28px;
  }

  .paras p {
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.62;
    color: var(--ink-2);
    text-wrap: pretty;
    max-width: 36em;
  }

  .paras p + p {
    margin-top: 1em;
  }

  .paras .big {
    --fs: clamp(20px, 1.8vw, 24px);
    font-size: var(--fs);
    line-height: 1.4;
    font-weight: 500;
    font-stretch: 104%;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .cycle-note {
    margin: 4px auto 0;
    max-width: 26em;
    text-align: center;
    font-size: 15px;
    color: var(--ink-3);
  }

  .area {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(700px 500px at 78% 50%, color-mix(in srgb, var(--h) 9%, transparent), transparent 70%),
      var(--bg-0);
  }

  .area.flip {
    background:
      radial-gradient(700px 500px at 22% 50%, color-mix(in srgb, var(--h) 9%, transparent), transparent 70%),
      var(--bg-0);
  }

  .area-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .flip .area-grid {
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
  }

  .flip .area-copy {
    order: 2;
  }

  .area .kicker::before {
    background: linear-gradient(90deg, var(--h), transparent);
  }

  .area .h2 {
    --measure: 16em;
    max-width: var(--measure);
  }

  .area .paras p {
    font-size: 17px;
  }

  .work {
    margin-top: 32px;
  }

  .work ul {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 24px;
    max-width: 560px;
  }

  .work li {
    position: relative;
    padding: 10px 0 10px 18px;
    border-top: 1px solid var(--line);
    font-size: 15px;
    color: var(--ink);
  }

  .work li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 18px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--h);
    box-shadow: 0 0 8px var(--h);
  }

  .tile {
    position: relative;
    aspect-ratio: 1;
    max-width: 360px;
    width: 100%;
    margin-inline: auto;
    display: grid;
    place-items: center;
    border-radius: 28px;
    border: 1px solid color-mix(in srgb, var(--h) 28%, transparent);
    background:
      radial-gradient(closest-side, color-mix(in srgb, var(--h) 14%, transparent), transparent),
      linear-gradient(rgba(60, 170, 255, 0.03) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, rgba(60, 170, 255, 0.03) 1px, transparent 1px) 0 0 / 32px 32px,
      rgba(4, 9, 20, 0.6);
    box-shadow: var(--shadow-float);
  }

  .tile :global(.emblem) {
    width: 58%;
    height: auto;
  }

  @media (max-width: 900px) {
    .grid,
    .area-grid,
    .flip .area-grid {
      grid-template-columns: 1fr;
    }

    .flip .area-copy {
      order: 0;
    }

    .tile {
      max-width: 240px;
      margin: 8px 0 0;
    }
  }

  @media (max-width: 560px) {
    .work ul {
      grid-template-columns: 1fr;
    }

    /* On phones the emblem leads its section, like the business cards on Home, instead of trailing the list. */
    .area-grid,
    .flip .area-grid {
      gap: 28px;
    }

    .tile {
      order: -1;
      max-width: 112px;
      margin: 0;
      border-radius: 22px;
    }
  }
</style>
