---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/shared/PageHero.astro";
import ContactCTA from "../components/shared/ContactCTA.astro";
import { SEO } from "../data/site";
import { company as c } from "../content/company";
import { edit, parts } from "../content/schema";
---

<BaseLayout variant="home" title={SEO.company.title} description={SEO.company.description} path="/company">
  <PageHero tone="company" copy={c.hero} primary="/platform" secondary="/businesses">
    <svg slot="backdrop" class="horizon" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMid slice">
      <defs>
        <linearGradient id="hz" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="rgba(127,227,255,0)" />
          <stop offset="0.55" stop-color="rgba(127,227,255,0.55)" />
          <stop offset="1" stop-color="rgba(139,123,255,0)" />
        </linearGradient>
      </defs>
      <circle cx="1120" cy="980" r="760" fill="none" stroke="url(#hz)" stroke-width="1" />
      <circle cx="1120" cy="980" r="700" fill="none" stroke="rgba(110,190,255,0.08)" stroke-width="1" />
      <circle cx="1120" cy="980" r="640" fill="none" stroke="rgba(110,190,255,0.05)" stroke-width="1" />
    </svg>
  </PageHero>

  <section class="section about" id="about" aria-labelledby="about-title">
    <div class="wrap grid">
      <div class="lead reveal">
        <p class="label kicker" {...edit(c.about.eyebrow, "eyebrow")}>{c.about.eyebrow.text}</p>
        <h2 class="h2" id="about-title" {...edit(c.about.headline, "heading", ["size", "above", "below"])}>{c.about.headline.text}</h2>
      </div>
      <div class="essay">
        <p class="first reveal" {...edit(c.about.lead, "text", ["size", "width", "above", "below"])}>{c.about.lead.text}</p>
        {parts(c.about.body).map(({ text, part }) => <p class="reveal" {...edit(c.about.body, "paragraphs", ["width", "above", "below"], { part })}>{text}</p>)}
      </div>
    </div>
  </section>

  <section class="section model" id="how-we-work" aria-labelledby="model-title">
    <div class="wrap">
      <div class="model-head reveal">
        <p class="label kicker" {...edit(c.model.eyebrow, "eyebrow")}>{c.model.eyebrow.text}</p>
        <h2 class="h2" id="model-title" {...edit(c.model.headline, "heading", ["size", "width", "above", "below"])}>{c.model.headline.text}</h2>
      </div>
      <div class="model-body" {...edit(c.model.body, "paragraphs", ["above", "below"])}>
        {c.model.body.text.map((p) => <p class="reveal">{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section vision" id="vision" aria-labelledby="vision-title">
    <div class="wrap">
      <div class="vision-head reveal">
        <p class="label kicker" {...edit(c.vision.eyebrow, "eyebrow")}>{c.vision.eyebrow.text}</p>
        <h2 class="h2" id="vision-title" {...edit(c.vision.headline, "heading", ["size", "width", "above", "below"])}>{c.vision.headline.text}</h2>
      </div>
      <div class="essay vision-essay">
        <p class="reveal" {...edit(c.vision.intro, "text", ["above", "below"])}>{c.vision.intro.text}</p>
        <p class="reveal questions" {...edit(c.vision.questions, "text", ["size", "above", "below"])}>{c.vision.questions.text}</p>
        {parts(c.vision.body).map(({ text, part }) => <p class="reveal" {...edit(c.vision.body, "paragraphs", ["above", "below"], { part })}>{text}</p>)}
      </div>
    </div>
  </section>

  <section class="section beliefs-section" id="beliefs" aria-label="How we think">
    <div class="wrap">
      <p class="label kicker reveal" {...edit(c.beliefs.eyebrow, "eyebrow")}>{c.beliefs.eyebrow.text}</p>
      <ul class="beliefs">
        {
          c.beliefs.items.map((b, i) => (
            <li class="reveal" style={`--d: ${i * 70}ms`}>
              <h3 {...edit(b.title, "heading")}>{b.title.text}</h3>
              <p {...edit(b.body, "text")}>{b.body.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ContactCTA id="contact" copy={c.contact} secondary="/technology" />
</BaseLayout>

<style>
  .horizon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .essay p {
    font-size: clamp(18px, 1.55vw, 20px);
    line-height: 1.62;
    color: var(--ink-2);
    --measure: 34em;
    max-width: var(--measure);
    text-wrap: pretty;
  }

  .essay p + p {
    margin-top: 1em;
  }

  .essay .first {
    --fs: clamp(22px, 2.1vw, 28px);
    font-size: var(--fs);
    line-height: 1.4;
    font-weight: 500;
    font-stretch: 104%;
    letter-spacing: -0.012em;
    color: var(--ink);
  }

  .model {
    border-top: 1px solid var(--line);
    background:
      linear-gradient(rgba(60, 170, 255, 0.025) 1px, transparent 1px) 0 0 / 44px 44px,
      linear-gradient(90deg, rgba(60, 170, 255, 0.025) 1px, transparent 1px) 0 0 / 44px 44px,
      var(--bg-1);
  }

  .model-head {
    max-width: 1000px;
  }

  .model-body {
    margin-top: clamp(40px, 5vw, 64px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px clamp(32px, 5vw, 72px);
    max-width: 1100px;
  }

  .model-body p {
    padding-top: 18px;
    border-top: 1px solid var(--line-2);
    font-size: 18px;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .vision {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(900px 600px at 20% 40%, rgba(139, 123, 255, 0.07), transparent 70%),
      var(--bg-0);
  }

  .vision-head {
    max-width: 920px;
  }

  .vision-essay {
    margin-top: clamp(40px, 5vw, 64px);
    margin-left: auto;
    max-width: 760px;
  }

  .vision-essay .questions {
    padding-left: 24px;
    border-left: 1px solid var(--cyan);
    --fs: clamp(20px, 1.9vw, 25px);
    font-size: var(--fs);
    line-height: 1.5;
    font-weight: 500;
    font-stretch: 104%;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-block: 1.4em;
  }

  .beliefs-section {
    border-top: 1px solid var(--line);
    background: var(--bg-0);
  }

  .beliefs {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
  }

  .beliefs li {
    padding-top: 22px;
    border-top: 1px solid var(--line-2);
  }

  .beliefs h3 {
    margin: 0;
    font-size: 22px;
    font-weight: 560;
    font-stretch: 108%;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .beliefs p {
    margin-top: 10px;
    color: var(--ink-2);
    font-size: 15.5px;
  }

  @media (max-width: 960px) {
    .beliefs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .grid,
    .model-body {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .beliefs {
      grid-template-columns: 1fr;
    }
  }
</style>
