---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/shared/PageHero.astro";
import ContactCTA from "../components/shared/ContactCTA.astro";
import { SEO } from "../data/site";

const beliefs = [
  {
    t: "Real operations matter.",
    d: "Software built to run businesses should be shaped by real business problems, not only demonstrations.",
  },
  {
    t: "Learning should survive the task.",
    d: "Useful knowledge should remain available after the work that produced it is finished.",
  },
  {
    t: "Autonomy needs boundaries.",
    d: "Software can take on more responsibility without taking every decision away from people.",
  },
  {
    t: "Better software should lead to better operations.",
    d: "The point is not to make agents look busy. The point is to help the business perform better.",
  },
];
---

<BaseLayout variant="home" title={SEO.company.title} description={SEO.company.description} path="/company">
  <PageHero
    tone="company"
    kicker="Company"
    title="Building the technology behind a new kind of business."
    body={[
      "Digit Software is a software company building technology for autonomous business operations.",
      "We develop that technology and use it across businesses of our own, giving us a direct way to learn how intelligent software performs when it is responsible for real work.",
    ]}
    primary={{ href: "/platform", label: "Our Platform" }}
    secondary={{ href: "/businesses", label: "Our Businesses" }}
  >
    <svg slot="backdrop" class="horizon" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMid slice">
      <defs>
        <linearGradient id="hz" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="rgba(127,227,255,0)" />
          <stop offset="0.55" stop-color="rgba(127,227,255,0.55)" />
          <stop offset="1" stop-color="rgba(139,123,255,0)" />
        </linearGradient>
      </defs>
      <circle cx="1120" cy="980" r="760" fill="none" stroke="url(#hz)" stroke-width="1" />
      <circle cx="1120" cy="980" r="700" fill="none" stroke="rgba(110,190,255,0.08)" stroke-width="1" />
      <circle cx="1120" cy="980" r="640" fill="none" stroke="rgba(110,190,255,0.05)" stroke-width="1" />
    </svg>
  </PageHero>

  <section class="section about" id="about" aria-labelledby="about-title">
    <div class="wrap grid">
      <div class="lead reveal">
        <p class="label kicker">About Digit</p>
        <h2 class="h2" id="about-title">A software company that operates businesses, too.</h2>
      </div>
      <div class="essay">
        <p class="first reveal">Digit builds software that can take on more of the work involved in running a business.</p>
        <p class="reveal">
          That includes coordinating work, carrying out tasks through specialized agents, keeping institutional knowledge
          available, learning from results, and giving people a clear way to supervise what the software is doing.
        </p>
        <p class="reveal">
          We use the same technology across businesses in our own portfolio. The problems those businesses encounter become
          engineering problems we can solve. The results show us what works, what does not, and what the software needs next.
        </p>
        <p class="reveal">That relationship between software and operations is central to Digit.</p>
      </div>
    </div>
  </section>

  <section class="section model" id="how-we-work" aria-labelledby="model-title">
    <div class="wrap">
      <div class="model-head reveal">
        <p class="label kicker">How We Work</p>
        <h2 class="h2" id="model-title">Build the technology. Run businesses with it. Learn from the results.</h2>
      </div>
      <div class="model-body">
        <p class="reveal">
          Digit develops the systems behind increasingly autonomous operations and puts them to work inside its own portfolio.
        </p>
        <p class="reveal">
          Operating businesses gives the technology real constraints. Work has deadlines. Decisions have consequences. Systems
          fail. Markets change. Results can be measured.
        </p>
        <p class="reveal">
          Those conditions shape what we build far more than a controlled demonstration ever could.
        </p>
        <p class="reveal">
          Over time, the same software and infrastructure can support organizations outside Digit through products,
          platforms, and systems built for their operations.
        </p>
      </div>
    </div>
  </section>

  <section class="section vision" id="vision" aria-labelledby="vision-title">
    <div class="wrap">
      <div class="vision-head reveal">
        <p class="label kicker">Vision</p>
        <h2 class="h2" id="vision-title">A business should get better at running itself.</h2>
      </div>
      <div class="essay vision-essay">
        <p class="reveal">Automation can make individual tasks faster. Digit is interested in the larger problem.</p>
        <p class="reveal questions">
          How does a business carry work forward without waiting for a person to assign every next step? How does it keep
          what it learns? How does it adapt when results change? How does it become more capable without losing human
          control?
        </p>
        <p class="reveal">We are building software around those questions.</p>
        <p class="reveal">
          The long-term goal is technology that can take responsibility for more of a company's operation while the people
          behind the business remain responsible for its direction.
        </p>
      </div>
    </div>
  </section>

  <section class="section beliefs-section" id="beliefs" aria-label="How we think">
    <div class="wrap">
      <p class="label kicker reveal">How We Think</p>
      <ul class="beliefs">
        {
          beliefs.map((b, i) => (
            <li class="reveal" style={`--d: ${i * 70}ms`}>
              <h3>{b.t}</h3>
              <p>{b.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ContactCTA
    id="contact"
    headline="Want to know more about Digit?"
    body="For company inquiries, partnerships, technology discussions, or general questions, get in touch."
    secondary={{ href: "/technology", label: "Explore the Technology" }}
  />
</BaseLayout>

<style>
  .horizon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .essay p {
    font-size: clamp(18px, 1.55vw, 20px);
    line-height: 1.62;
    color: var(--ink-2);
    max-width: 34em;
    text-wrap: pretty;
  }

  .essay p + p {
    margin-top: 1em;
  }

  .essay .first {
    font-size: clamp(22px, 2.1vw, 28px);
    line-height: 1.4;
    font-weight: 500;
    font-stretch: 104%;
    letter-spacing: -0.012em;
    color: var(--ink);
  }

  .model {
    border-top: 1px solid var(--line);
    background:
      linear-gradient(rgba(60, 170, 255, 0.025) 1px, transparent 1px) 0 0 / 44px 44px,
      linear-gradient(90deg, rgba(60, 170, 255, 0.025) 1px, transparent 1px) 0 0 / 44px 44px,
      var(--bg-1);
  }

  .model-head {
    max-width: 1000px;
  }

  .model-body {
    margin-top: clamp(40px, 5vw, 64px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px clamp(32px, 5vw, 72px);
    max-width: 1100px;
  }

  .model-body p {
    padding-top: 18px;
    border-top: 1px solid var(--line-2);
    font-size: 18px;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .vision {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(900px 600px at 20% 40%, rgba(139, 123, 255, 0.07), transparent 70%),
      var(--bg-0);
  }

  .vision-head {
    max-width: 920px;
  }

  .vision-essay {
    margin-top: clamp(40px, 5vw, 64px);
    margin-left: auto;
    max-width: 760px;
  }

  .vision-essay .questions {
    padding-left: 24px;
    border-left: 1px solid var(--cyan);
    font-size: clamp(20px, 1.9vw, 25px);
    line-height: 1.5;
    font-weight: 500;
    font-stretch: 104%;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-block: 1.4em;
  }

  .beliefs-section {
    border-top: 1px solid var(--line);
    background: var(--bg-0);
  }

  .beliefs {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
  }

  .beliefs li {
    padding-top: 22px;
    border-top: 1px solid var(--line-2);
  }

  .beliefs h3 {
    margin: 0;
    font-size: 22px;
    font-weight: 560;
    font-stretch: 108%;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .beliefs p {
    margin-top: 10px;
    color: var(--ink-2);
    font-size: 15.5px;
  }

  @media (max-width: 960px) {
    .beliefs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .grid,
    .model-body {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .beliefs {
      grid-template-columns: 1fr;
    }
  }
</style>
