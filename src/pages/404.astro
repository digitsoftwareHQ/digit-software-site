---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="This page does not exist." path="/404" noindex>
  <section class="nf wrap">
    <p class="label kicker">404</p>
    <h1 class="h2">This page doesn't exist.</h1>
    <p class="lede">It may have moved when the site was rebuilt. Everything starts from the home page.</p>
    <a class="btn btn--primary" href="/">Go to the home page</a>
  </section>
</BaseLayout>

<style>
  .nf {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 24px;
    padding-block: 96px;
  }
</style>
