---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/shared/PageHero.astro";
import ClosingBand from "../components/shared/ClosingBand.astro";
import ContactCTA from "../components/shared/ContactCTA.astro";
import { SEO } from "../data/site";

const chapters = [
  { id: "system", label: "The System" },
  { id: "execution", label: "Execution" },
  { id: "agents", label: "Specialized Agents" },
  { id: "coordination", label: "Coordination" },
  { id: "knowledge", label: "Knowledge" },
  { id: "governance", label: "Governance" },
  { id: "integrations", label: "Connections" },
  { id: "observability", label: "Observability" },
  { id: "reliability", label: "Reliability" },
];

const coreAreas = [
  "Execution",
  "Specialized Agents",
  "Operational Coordination",
  "Knowledge",
  "Learning",
  "Governance",
  "Integrations",
  "Observability",
  "Reliability",
];

const execution = [
  { t: "Carry Work Forward", d: "Keep multi-step work connected instead of treating every action as a new conversation." },
  { t: "Use Approved Capabilities", d: "Give software access to the systems and tools required for the work it has been allowed to perform." },
  { t: "Record What Happened", d: "Maintain enough history to understand what was attempted, what completed, and what failed." },
  { t: "Recover Safely", d: "Resume work where it is safe to do so and stop when the system cannot determine what happened." },
];

const knowledge = [
  { t: "Provenance", d: "Keep useful context about where knowledge came from." },
  { t: "Relationships", d: "Connect information that becomes more useful when viewed together." },
  { t: "Reuse", d: "Make prior knowledge available to future work." },
  { t: "Learning", d: "Allow results and evidence to improve how work is handled over time." },
];

const governance = [
  { t: "Routine Work", d: "Continue within the authority already given.", tone: "go" },
  { t: "Sensitive Work", d: "Require stronger controls or explicit human involvement.", tone: "ask" },
  { t: "Financial Authority", d: "Keep spending and commitments inside defined limits.", tone: "ask" },
  { t: "External Authority", d: "Control when software can represent or commit the business.", tone: "ask" },
  { t: "Human Decisions", d: "Keep consequential choices with the people responsible for them.", tone: "human" },
];

const connections = [
  { t: "Tools", d: "Give software the capabilities required for a particular kind of work." },
  { t: "Services", d: "Connect outside systems without making the platform depend on one vendor." },
  { t: "Data", d: "Bring relevant information into the work when it is needed." },
  { t: "Actions", d: "Allow approved work to move from analysis into execution." },
];

const reliability = [
  { t: "Detect", d: "Know when execution did not complete as expected." },
  { t: "Preserve", d: "Keep the state and evidence needed to understand the problem." },
  { t: "Recover", d: "Continue automatically when the next step is safe and known." },
  { t: "Escalate", d: "Bring uncertainty to a person when the system cannot resolve it safely." },
];

// Diagram labels restate phrases from the chapter copy.
const specialists = ["Research", "Analysis", "Product work", "Quality review", "Creative work", "Operations"];
const context = ["Objectives", "Current context", "Previous decisions", "Available resources", "What the business has already learned"];
const states = [
  { t: "Active", tone: "live" },
  { t: "Completed", tone: "ok" },
  { t: "Failed", tone: "bad" },
  { t: "Changed", tone: "neutral" },
  { t: "A person may need to step in", tone: "ask" },
];
---

<BaseLayout variant="home" title={SEO.technology.title} description={SEO.technology.description} path="/technology">
  <PageHero
    tone="technology"
    kicker="Technology"
    title="Engineering the systems behind autonomous operations."
    body={[
      "For software to operate part of a business, it has to do more than generate an answer.",
      "It has to carry work across steps, use tools safely, keep context, recover when something breaks, learn from what happened, and stay visible to the people responsible for it.",
      "We build that infrastructure from the ground up.",
    ]}
    primary={{ href: "/platform", label: "Our Platform" }}
    secondary={{ href: "/company", label: "About Digit" }}
  />

  <div class="wrap doc">
    <nav class="toc" aria-label="On this page" data-toc>
      <p class="label">On this page</p>
      <ol>
        {
          chapters.map((c, i) => (
            <li>
              <a href={`#${c.id}`} data-toc-link={c.id}>
                <span class="label">{String(i + 1).padStart(2, "0")}</span>
                {c.label}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="chapters">
      <section class="chapter" id="system" aria-labelledby="system-title">
        <p class="label kicker reveal">The System</p>
        <h2 class="h2 reveal" id="system-title">Intelligence has to become reliable execution.</h2>
        <div class="text reveal">
          <p>A useful business system has to connect reasoning with real work.</p>
          <p>
            An objective needs to become a sequence of actions. Different kinds of work may need different specialists. Those
            specialists need access to the right information and approved capabilities. Results need to be recorded. Failures
            need a known state. Important decisions need clear boundaries.
          </p>
          <p>Digit's technology is built around making that full path work as one system.</p>
        </div>
        <figure class="schematic core reveal">
          <figcaption class="label">Core Areas</figcaption>
          <ul>
            {coreAreas.map((a) => <li>{a}</li>)}
          </ul>
        </figure>
      </section>

      <section class="chapter" id="execution" aria-labelledby="execution-title">
        <p class="label kicker reveal">Execution</p>
        <h2 class="h2 reveal" id="execution-title">Work has to survive more than one prompt.</h2>
        <div class="text reveal">
          <p>Business operations often span multiple steps, systems, decisions, and periods of time.</p>
          <p>
            Digit's execution infrastructure is designed to carry that work forward while keeping track of what has happened and
            what still needs to happen.
          </p>
          <p>
            Morpheus is Digit's execution runtime. It provides the environment where software can use approved capabilities,
            perform work, record outcomes, and recover when execution does not go as planned.
          </p>
          <p>The runtime is not the business logic itself. It is the infrastructure that lets the rest of the platform act.</p>
        </div>
        <ol class="schematic steps four reveal">
          {
            execution.map((s, i) => (
              <li>
                <span class="label">{String(i + 1).padStart(2, "0")}</span>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="chapter" id="agents" aria-labelledby="agents-title">
        <p class="label kicker reveal">Specialized Agents</p>
        <h2 class="h2 reveal" id="agents-title">Different work needs different specialists.</h2>
        <div class="text reveal">
          <p>A single general-purpose agent does not need to do every job.</p>
          <p>
            Digit can use specialized agents for research, analysis, product work, quality review, creative work, operations, and
            other focused responsibilities.
          </p>
          <p>
            The important part is not the number of agents. It is how the work is assigned, what each specialist is allowed to
            do, what information it receives, and how its result becomes part of the larger operation.
          </p>
          <p>
            Specialization gives the system a way to use different capabilities without turning the company into a collection of
            disconnected bots.
          </p>
        </div>
        <figure class="schematic spokes reveal" aria-hidden="true">
          <div class="ring">
            {specialists.map((s) => <span class="chip">{s}</span>)}
          </div>
          <span class="hub">The larger operation</span>
        </figure>
      </section>

      <section class="chapter" id="coordination" aria-labelledby="coordination-title">
        <p class="label kicker reveal">Coordination</p>
        <h2 class="h2 reveal" id="coordination-title">Work has to stay connected to the business around it.</h2>
        <div class="text reveal">
          <p>A task can be completed correctly and still be the wrong thing to do.</p>
          <p>
            Digit's operating systems are designed to keep work connected to objectives, current context, previous decisions,
            available resources, and what the business has already learned.
          </p>
          <p>That allows different pieces of work to contribute to a larger outcome instead of ending as isolated outputs.</p>
          <p>
            The result is software that can operate across longer stretches of work while keeping people able to inspect what is
            happening.
          </p>
        </div>
        <figure class="schematic converge reveal" aria-hidden="true">
          <div class="inputs">
            {context.map((c) => <span class="chip">{c}</span>)}
          </div>
          <span class="arrow">→</span>
          <span class="box">Work</span>
          <span class="arrow">→</span>
          <span class="box final">A larger outcome</span>
        </figure>
      </section>

      <section class="chapter" id="knowledge" aria-labelledby="knowledge-title">
        <p class="label kicker reveal">Knowledge</p>
        <h2 class="h2 reveal" id="knowledge-title">The system should remember what mattered.</h2>
        <div class="text reveal">
          <p>Business knowledge loses value when it disappears into old conversations, files, or one-off outputs.</p>
          <p>Digit keeps useful knowledge available beyond the task that created it.</p>
          <p>
            Research can support future decisions. An experiment can change how a process works. A failed approach can prevent
            the same mistake later. A procedure can improve as new evidence appears.
          </p>
          <p>Cerebro provides the connected knowledge layer behind that continuity.</p>
        </div>
        <ul class="schematic cards four reveal">
          {
            knowledge.map((k) => (
              <li>
                <h3>{k.t}</h3>
                <p>{k.d}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="chapter" id="governance" aria-labelledby="governance-title">
        <p class="label kicker reveal">Governance</p>
        <h2 class="h2 reveal" id="governance-title">Authority is part of the architecture.</h2>
        <div class="text reveal">
          <p>Software becoming more capable does not require giving it unlimited authority.</p>
          <p>Digit separates what the system can technically do from what it is allowed to do inside a business.</p>
          <p>
            Routine work can move within defined limits. Sensitive actions can require a person. Financial commitments, security
            changes, important external actions, and other consequential decisions can be handled differently from ordinary
            operations.
          </p>
          <p>
            Those boundaries travel with the work rather than depending on an agent to decide whether it should ask permission.
          </p>
        </div>
        <ul class="schematic tiers reveal">
          {
            governance.map((g) => (
              <li class={g.tone}>
                <h3>{g.t}</h3>
                <p>{g.d}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="chapter" id="integrations" aria-labelledby="integrations-title">
        <p class="label kicker reveal">Connections</p>
        <h2 class="h2 reveal" id="integrations-title">Business software has to work with the systems around it.</h2>
        <div class="text reveal">
          <p>Useful autonomous software cannot operate in isolation.</p>
          <p>
            Businesses already depend on communication tools, financial systems, marketplaces, databases, cloud services,
            productivity software, internal applications, and other infrastructure.
          </p>
          <p>
            Digit is designed so capabilities can be connected to the operating system without making every integration part of
            the core platform.
          </p>
          <p>
            A connection gives the software a way to interact with another system. The authority to use that connection is
            handled separately.
          </p>
        </div>
        <ul class="schematic cards four reveal">
          {
            connections.map((k) => (
              <li>
                <h3>{k.t}</h3>
                <p>{k.d}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="chapter" id="observability" aria-labelledby="observability-title">
        <p class="label kicker reveal">Observability</p>
        <h2 class="h2 reveal" id="observability-title">If the software acts, people should be able to see what happened.</h2>
        <div class="text reveal">
          <p>Autonomous operation requires visibility.</p>
          <p>
            The system needs to know what work is active, what completed, what failed, what changed, and where a person may need
            to step in.
          </p>
          <p>
            That information also gives Mission Control a reliable picture of the business instead of forcing people to
            reconstruct events from raw logs.
          </p>
          <p>Good observability is not more noise. It is enough information to understand the state of the operation.</p>
        </div>
        <figure class="schematic states reveal" aria-hidden="true">
          {
            states.map((s) => (
              <span class:list={["state", s.tone]}>
                <i />
                {s.t}
              </span>
            ))
          }
        </figure>
      </section>

      <section class="chapter" id="reliability" aria-labelledby="reliability-title">
        <p class="label kicker reveal">Reliability</p>
        <h2 class="h2 reveal" id="reliability-title">Reliable software has to fail clearly.</h2>
        <div class="text reveal">
          <p>Failures are unavoidable. Hidden failures are the bigger problem.</p>
          <p>
            When something goes wrong, Digit's infrastructure is designed to preserve enough state to understand what happened and
            determine what can safely happen next.
          </p>
          <p>Some work can be retried. Some can resume from a known point. Some should stop until a person resolves the uncertainty.</p>
          <p>
            The system should not silently lose work, invent success, or repeat consequential actions simply because the previous
            attempt is unclear.
          </p>
        </div>
        <ol class="schematic steps four reveal">
          {
            reliability.map((s, i) => (
              <li>
                <span class="label">{String(i + 1).padStart(2, "0")}</span>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </div>

  <ClosingBand
    headline="The goal is not more automation. It is software that can take responsibility for more of the operation."
    body={[
      "Execution, knowledge, governance, integrations, learning, and reliability all matter because business work does not happen in isolation.",
      "Digit is building those systems as one operating foundation.",
    ]}
    cta={{ href: "/platform", label: "Explore the Platform" }}
  />

  <ContactCTA
    headline="Working on the same problems?"
    body="If you're building, researching, or operating systems in this space, we'd like to hear from you."
    secondary={{ href: "/businesses", label: "Our Businesses" }}
  />
</BaseLayout>

<script>
  // Highlight the chapter currently being read in the table of contents.
  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>("[data-toc-link]").forEach((a) => links.set(a.dataset.tocLink!, a));
  const sections = [...links.keys()].map((id) => document.getElementById(id)).filter((s): s is HTMLElement => !!s);
  if (sections.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a, id) => {
            const on = id === e.target.id;
            a.classList.toggle("is-active", on);
            if (on) a.setAttribute("aria-current", "true");
            else a.removeAttribute("aria-current");
          });
        }
      },
      { rootMargin: "-40% 0px -55% 0px" },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>

<style>
  .doc {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: clamp(40px, 5vw, 80px);
    padding-top: clamp(72px, 9vw, 120px);
    padding-bottom: clamp(48px, 6vw, 80px);
  }

  .toc {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    align-self: start;
  }

  .toc ol {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }

  .toc a {
    position: relative;
    display: flex;
    gap: 10px;
    align-items: baseline;
    padding: 8px 0 8px 16px;
    font-size: 14.5px;
    color: var(--ink-3);
    text-decoration: none;
    transition: color var(--fast) var(--ease);
  }

  .toc a .label {
    font-size: 10.5px;
  }

  .toc a:hover,
  .toc a.is-active {
    color: var(--ink);
  }

  .toc a.is-active::before {
    content: "";
    position: absolute;
    left: -1px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--cyan);
    box-shadow: 0 0 8px var(--cyan);
  }

  .toc a.is-active .label {
    color: var(--cyan);
  }

  .chapter {
    padding-bottom: clamp(88px, 11vw, 150px);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  .chapter .h2 {
    max-width: 18em;
  }

  .text {
    margin-top: 24px;
    max-width: 44em;
  }

  .text p {
    color: var(--ink-2);
    font-size: 17.5px;
    text-wrap: pretty;
  }

  .text p + p {
    margin-top: 1em;
  }

  .text p:first-child {
    font-size: clamp(19px, 1.6vw, 22px);
    font-weight: 500;
    font-stretch: 104%;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .schematic {
    position: relative;
    margin: 40px 0 0;
    padding: clamp(18px, 2.4vw, 28px);
    border-radius: 20px;
    border: 1px solid var(--line-2);
    background:
      linear-gradient(rgba(60, 170, 255, 0.035) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, rgba(60, 170, 255, 0.035) 1px, transparent 1px) 0 0 / 32px 32px,
      rgba(3, 8, 18, 0.72);
    font-size: 14.5px;
    list-style: none;
  }

  .schematic h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 580;
    letter-spacing: -0.005em;
  }

  .schematic p {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* core areas */
  .core ul {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .core li {
    padding: 13px 16px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: rgba(10, 22, 44, 0.8);
    font-weight: 560;
  }

  /* numbered steps */
  .steps {
    display: grid;
    gap: 14px;
  }

  .steps.four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .steps li {
    position: relative;
    padding: 16px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: rgba(10, 22, 44, 0.8);
  }

  .steps li:not(:last-child)::after {
    content: "→";
    position: absolute;
    right: -12px;
    top: 50%;
    transform: translate(50%, -50%);
    color: var(--cyan);
    z-index: 1;
  }

  .steps .label {
    color: var(--cyan);
    font-size: 10.5px;
  }

  .steps h3 {
    margin-top: 8px;
  }

  /* cards */
  .cards {
    display: grid;
    gap: 12px;
  }

  .cards.four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .cards li {
    padding: 16px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: rgba(10, 22, 44, 0.8);
  }

  /* specialists */
  .spokes {
    display: grid;
    justify-items: center;
    gap: 22px;
    padding-block: 32px;
  }

  .spokes .ring {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: 640px;
  }

  .chip {
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: rgba(10, 22, 44, 0.8);
    font-size: 14px;
    color: var(--ink);
  }

  .hub {
    position: relative;
    padding: 12px 20px;
    border-radius: 12px;
    border: 1px solid rgba(39, 196, 255, 0.6);
    background: rgba(39, 196, 255, 0.1);
    box-shadow: 0 0 24px -8px rgba(39, 196, 255, 0.7);
    font-weight: 580;
  }

  .hub::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 100%;
    width: 1px;
    height: 22px;
    background: linear-gradient(180deg, rgba(127, 227, 255, 0.1), rgba(127, 227, 255, 0.6));
  }

  /* convergence */
  .converge {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .inputs {
    flex: 1.4 1 0;
    display: grid;
    gap: 8px;
  }

  .inputs .chip {
    border-radius: 10px;
    padding: 9px 12px;
    font-size: 13.5px;
    color: var(--ink-2);
  }

  .converge .arrow {
    color: var(--cyan);
  }

  .box {
    flex: 1 1 0;
    padding: 16px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: rgba(10, 22, 44, 0.8);
    text-align: center;
    font-weight: 580;
  }

  .box.final {
    border-color: rgba(39, 196, 255, 0.7);
    background: rgba(39, 196, 255, 0.1);
    box-shadow: 0 0 24px -8px rgba(39, 196, 255, 0.6);
  }

  /* governance */
  .tiers {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
  }

  .tiers li {
    padding: 16px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: rgba(10, 22, 44, 0.8);
  }

  .tiers .go {
    border-color: rgba(61, 220, 151, 0.45);
  }

  .tiers .ask {
    border-color: rgba(255, 181, 71, 0.45);
  }

  .tiers .human {
    border-color: rgba(39, 196, 255, 0.65);
    box-shadow: 0 0 24px -10px rgba(39, 196, 255, 0.7);
  }

  /* observability */
  .states {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .state {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 10px 16px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: rgba(10, 22, 44, 0.8);
    font-weight: 520;
  }

  .state i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink-3);
  }

  .state.live i {
    background: var(--cyan);
    box-shadow: 0 0 8px var(--cyan);
  }

  .state.ok i {
    background: #3ddc97;
  }

  .state.bad i {
    background: #ff5a6a;
  }

  .state.ask i {
    background: #ffb547;
    box-shadow: 0 0 8px rgba(255, 181, 71, 0.6);
  }

  @media (max-width: 1240px) {
    .tiers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 1080px) {
    .doc {
      grid-template-columns: 1fr;
    }

    .toc {
      position: static;
    }

    .toc ol {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      border-left: 0;
    }

    .toc a {
      padding: 7px 14px 7px 10px;
      border-radius: 999px;
      border: 1px solid var(--line-2);
      font-size: 13.5px;
    }

    .toc a.is-active::before {
      display: none;
    }

    .steps.four,
    .cards.four {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .steps li:nth-child(2)::after {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .core ul,
    .steps.four,
    .cards.four,
    .tiers {
      grid-template-columns: 1fr;
    }

    .steps li:not(:last-child)::after {
      display: block;
      content: "↓";
      right: 50%;
      top: auto;
      bottom: -12px;
      transform: translate(50%, 50%);
    }

    .converge {
