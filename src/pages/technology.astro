---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/shared/PageHero.astro";
import ClosingBand from "../components/shared/ClosingBand.astro";
import ContactCTA from "../components/shared/ContactCTA.astro";
import { SEO } from "../data/site";
import { technology as t } from "../content/technology";
import { edit } from "../content/schema";

/** Chapter order. Each id is the chapter's anchor and the key for its copy in technology.json. */
const CHAPTERS = ["system", "execution", "agents", "coordination", "knowledge", "governance", "integrations", "observability", "reliability"] as const;
/** Visual tone of each governance tier and observability state, in content order. */
const TONES = ["go", "ask", "ask", "ask", "human"];
const STATES = ["live", "ok", "bad", "neutral", "ask"];
---

<BaseLayout variant="home" title={SEO.technology.title} description={SEO.technology.description} path="/technology">
  <PageHero tone="technology" copy={t.hero} primary="/platform" secondary="/company" />

  <div class="wrap doc">
    <nav class="toc" aria-label="On this page" data-toc>
      <p class="label" {...edit(t.tocLabel, "label")}>{t.tocLabel.text}</p>
      <ol>
        {
          CHAPTERS.map((id, i) => (
            <li>
              <a href={`#${id}`} data-toc-link={id} {...edit(t.chapters[id].eyebrow, "eyebrow", [], { href: `#${id}` })}>
                <span class="label">{String(i + 1).padStart(2, "0")}</span>
                {t.chapters[id].eyebrow.text}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="chapters">
      <section class="chapter" id="system" aria-labelledby="system-title">
        <p class="label kicker reveal" {...edit(t.chapters.system.eyebrow, "eyebrow")}>{t.chapters.system.eyebrow.text}</p>
        <h2 class="h2 reveal" id="system-title" {...edit(t.chapters.system.headline, "heading", ["size", "width", "above", "below"])}>{t.chapters.system.headline.text}</h2>
        <div class="text reveal" {...edit(t.chapters.system.body, "paragraphs", ["width", "above", "below"])}>
          {t.chapters.system.body.text.map((p) => <p>{p}</p>)}
        </div>
        <figure class="schematic core reveal">
          <figcaption class="label" {...edit(t.chapters.system.coreLabel, "caption")}>{t.chapters.system.coreLabel.text}</figcaption>
          <ul {...edit(t.chapters.system.core, "list")}>
            {t.chapters.system.core.text.map((a) => <li>{a}</li>)}
          </ul>
        </figure>
      </section>

      <section class="chapter" id="execution" aria-labelledby="execution-title">
        <p class="label kicker reveal" {...edit(t.chapters.execution.eyebrow, "eyebrow")}>{t.chapters.execution.eyebrow.text}</p>
        <h2 class="h2 reveal" id="execution-title" {...edit(t.chapters.execution.headline, "heading", ["size", "width", "above", "below"])}>{t.chapters.execution.headline.text}</h2>
        <div class="text reveal" {...edit(t.chapters.execution.body, "paragraphs", ["width", "above", "below"])}>
          {t.chapters.execution.body.text.map((p) => <p>{p}</p>)}
        </div>
        <ol class="schematic steps four reveal">
          {
            t.chapters.execution.steps.map((s, i) => (
              <li>
                <span class="label">{String(i + 1).padStart(2, "0")}</span>
                <h3 {...edit(s.title, "heading")}>{s.title.text}</h3>
                <p {...edit(s.body, "text")}>{s.body.text}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="chapter" id="agents" aria-labelledby="agents-title">
        <p class="label kicker reveal" {...edit(t.chapters.agents.eyebrow, "eyebrow")}>{t.chapters.agents.eyebrow.text}</p>
        <h2 class="h2 reveal" id="agents-title" {...edit(t.chapters.agents.headline, "heading", ["size", "width", "above", "below"])}>{t.chapters.agents.headline.text}</h2>
        <div class="text reveal" {...edit(t.chapters.agents.body, "paragraphs", ["width", "above", "below"])}>
          {t.chapters.agents.body.text.map((p) => <p>{p}</p>)}
        </div>
        <figure class="schematic spokes reveal" aria-hidden="true">
          <div class="ring" {...edit(t.chapters.agents.specialists, "list")}>
            {t.chapters.agents.specialists.text.map((s) => <span class="chip">{s}</span>)}
          </div>
          <span class="hub" {...edit(t.chapters.agents.hub, "label")}>{t.chapters.agents.hub.text}</span>
        </figure>
      </section>

      <section class="chapter" id="coordination" aria-labelledby="coordination-title">
        <p class="label kicker reveal" {...edit(t.chapters.coordination.eyebrow, "eyebrow")}>{t.chapters.coordination.eyebrow.text}</p>
        <h2 class="h2 reveal" id="coordination-title" {...edit(t.chapters.coordination.headline, "heading", ["size", "width", "above", "below"])}>{t.chapters.coordination.headline.text}</h2>
        <div class="text reveal" {...edit(t.chapters.coordination.body, "paragraphs", ["width", "above", "below"])}>
          {t.chapters.coordination.body.text.map((p) => <p>{p}</p>)}
        </div>
        <figure class="schematic converge reveal" aria-hidden="true">
          <div class="inputs" {...edit(t.chapters.coordination.inputs, "list")}>
            {t.chapters.coordination.inputs.text.map((c) => <span class="chip">{c}</span>)}
          </div>
          <span class="arrow">→</span>
          <span class="box" {...edit(t.chapters.coordination.work, "label")}>{t.chapters.coordination.work.text}</span>
          <span class="arrow">→</span>
          <span class="box final" {...edit(t.chapters.coordination.outcome, "label")}>{t.chapters.coordination.outcome.text}</span>
        </figure>
      </section>

      <section class="chapter" id="knowledge" aria-labelledby="knowledge-title">
        <p class="label kicker reveal" {...edit(t.chapters.knowledge.eyebrow, "eyebrow")}>{t.chapters.knowledge.eyebrow.text}</p>
        <h2 class="h2 reveal" id="knowledge-title" {...edit(t.chapters.knowledge.headline, "heading", ["size", "width", "above", "below"])}>{t.chapters.knowledge.headline.text}</h2>
        <div class="text reveal" {...edit(t.chapters.knowledge.body, "paragraphs", ["width", "above", "below"])}>
          {t.chapters.knowledge.body.text.map((p) => <p>{p}</p>)}
        </div>
        <ul class="schematic cards four reveal">
          {
            t.chapters.knowledge.cards.map((s, i) => (
              <li>
                <h3 {...edit(s.title, "heading")}>{s.title.text}</h3>
                <p {...edit(s.body, "text")}>{s.body.text}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="chapter" id="governance" aria-labelledby="governance-title">
        <p class="label kicker reveal" {...edit(t.chapters.governance.eyebrow, "eyebrow")}>{t.chapters.governance.eyebrow.text}</p>
        <h2 class="h2 reveal" id="governance-title" {...edit(t.chapters.governance.headline, "heading", ["size", "width", "above", "below"])}>{t.chapters.governance.headline.text}</h2>
        <div class="text reveal" {...edit(t.chapters.governance.body, "paragraphs", ["width", "above", "below"])}>
          {t.chapters.governance.body.text.map((p) => <p>{p}</p>)}
        </div>
        <ul class="schematic tiers reveal">
          {
            t.chapters.governance.tiers.map((s, i) => (
              <li class={TONES[i]}>
                <h3 {...edit(s.title, "heading")}>{s.title.text}</h3>
                <p {...edit(s.body, "text")}>{s.body.text}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="chapter" id="integrations" aria-labelledby="integrations-title">
        <p class="label kicker reveal" {...edit(t.chapters.integrations.eyebrow, "eyebrow")}>{t.chapters.integrations.eyebrow.text}</p>
        <h2 class="h2 reveal" id="integrations-title" {...edit(t.chapters.integrations.headline, "heading", ["size", "width", "above", "below"])}>{t.chapters.integrations.headline.text}</h2>
        <div class="text reveal" {...edit(t.chapters.integrations.body, "paragraphs", ["width", "above", "below"])}>
          {t.chapters.integrations.body.text.map((p) => <p>{p}</p>)}
        </div>
        <ul class="schematic cards four reveal">
          {
            t.chapters.integrations.cards.map((s, i) => (
              <li>
                <h3 {...edit(s.title, "heading")}>{s.title.text}</h3>
                <p {...edit(s.body, "text")}>{s.body.text}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="chapter" id="observability" aria-labelledby="observability-title">
        <p class="label kicker reveal" {...edit(t.chapters.observability.eyebrow, "eyebrow")}>{t.chapters.observability.eyebrow.text}</p>
        <h2 class="h2 reveal" id="observability-title" {...edit(t.chapters.observability.headline, "heading", ["size", "width", "above", "below"])}>{t.chapters.observability.headline.text}</h2>
        <div class="text reveal" {...edit(t.chapters.observability.body, "paragraphs", ["width", "above", "below"])}>
          {t.chapters.observability.body.text.map((p) => <p>{p}</p>)}
        </div>
        <figure class="schematic states reveal" aria-hidden="true">
          {
            t.chapters.observability.states.map((s, i) => (
              <span class:list={["state", STATES[i]]} {...edit(s.label, "label")}>
                <i />
                {s.label.text}
              </span>
            ))
          }
        </figure>
      </section>

      <section class="chapter" id="reliability" aria-labelledby="reliability-title">
        <p class="label kicker reveal" {...edit(t.chapters.reliability.eyebrow, "eyebrow")}>{t.chapters.reliability.eyebrow.text}</p>
        <h2 class="h2 reveal" id="reliability-title" {...edit(t.chapters.reliability.headline, "heading", ["size", "width", "above", "below"])}>{t.chapters.reliability.headline.text}</h2>
        <div class="text reveal" {...edit(t.chapters.reliability.body, "paragraphs", ["width", "above", "below"])}>
          {t.chapters.reliability.body.text.map((p) => <p>{p}</p>)}
        </div>
        <ol class="schematic steps four reveal">
          {
            t.chapters.reliability.steps.map((s, i) => (
              <li>
                <span class="label">{String(i + 1).padStart(2, "0")}</span>
                <h3 {...edit(s.title, "heading")}>{s.title.text}</h3>
                <p {...edit(s.body, "text")}>{s.body.text}</p>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </div>

  <ClosingBand copy={t.closing} cta="/platform" />

  <ContactCTA copy={t.contact} secondary="/businesses" />
</BaseLayout>

<script>
  // Highlight the chapter currently being read in the table of contents.
  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>("[data-toc-link]").forEach((a) => links.set(a.dataset.tocLink!, a));
  const sections = [...links.keys()].map((id) => document.getElementById(id)).filter((s): s is HTMLElement => !!s);
  if (sections.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a, id) => {
            const on = id === e.target.id;
            a.classList.toggle("is-active", on);
            if (on) a.setAttribute("aria-current", "true");
            else a.removeAttribute("aria-current");
          });
        }
      },
      { rootMargin: "-40% 0px -55% 0px" },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>

<style>
  .doc {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: clamp(40px, 5vw, 80px);
    padding-top: clamp(72px, 9vw, 120px);
    padding-bottom: clamp(48px, 6vw, 80px);
  }

  .toc {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    align-self: start;
  }

  .toc ol {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }

  .toc a {
    position: relative;
    display: flex;
    gap: 10px;
    align-items: baseline;
    padding: 8px 0 8px 16px;
    font-size: 14.5px;
    color: var(--ink-3);
    text-decoration: none;
    transition: color var(--fast) var(--ease);
  }

  .toc a .label {
    font-size: 10.5px;
  }

  .toc a:hover,
  .toc a.is-active {
    color: var(--ink);
  }

  .toc a.is-active::before {
    content: "";
    position: absolute;
    left: -1px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--cyan);
    box-shadow: 0 0 8px var(--cyan);
  }

  .toc a.is-active .label {
    color: var(--cyan);
  }

  .chapter {
    padding-bottom: clamp(88px, 11vw, 150px);
  }

  .chapter .h2 {
    --measure: 18em;
    max-width: var(--measure);
  }

  .text {
    --measure: 44em;
    margin-top: 24px;
    max-width: var(--measure);
  }

  .text p {
    color: var(--ink-2);
    font-size: 17.5px;
    text-wrap: pretty;
  }

  .text p + p {
    margin-top: 1em;
  }

  .text p:first-child {
    font-size: clamp(19px, 1.6vw, 22px);
    font-weight: 500;
    font-stretch: 104%;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .schematic {
    position: relative;
    margin: 40px 0 0;
    padding: clamp(18px, 2.4vw, 28px);
    border-radius: 20px;
    border: 1px solid var(--line-2);
    background:
      linear-gradient(rgba(60, 170, 255, 0.035) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, rgba(60, 170, 255, 0.035) 1px, transparent 1px) 0 0 / 32px 32px,
      rgba(3, 8, 18, 0.72);
    font-size: 14.5px;
    list-style: none;
  }

  .schematic h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 580;
    letter-spacing: -0.005em;
  }

  .schematic p {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* core areas */
  .core ul {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .core li {
    padding: 13px 16px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: rgba(10, 22, 44, 0.8);
    font-weight: 560;
  }

  /* numbered steps */
  .steps {
    display: grid;
    gap: 14px;
  }

  .steps.four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .steps li {
    position: relative;
    padding: 16px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: rgba(10, 22, 44, 0.8);
  }

  .steps li:not(:last-child)::after {
    content: "→";
    position: absolute;
    right: -12px;
    top: 50%;
    transform: translate(50%, -50%);
    color: var(--cyan);
    z-index: 1;
  }

  .steps .label {
    color: var(--cyan);
    font-size: 10.5px;
  }

  .steps h3 {
    margin-top: 8px;
  }

  /* cards */
  .cards {
    display: grid;
    gap: 12px;
  }

  .cards.four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .cards li {
    padding: 16px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: rgba(10, 22, 44, 0.8);
  }

  /* specialists */
  .spokes {
    display: grid;
    justify-items: center;
    gap: 22px;
    padding-block: 32px;
  }

  .spokes .ring {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: 640px;
  }

  .chip {
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: rgba(10, 22, 44, 0.8);
    font-size: 14px;
    color: var(--ink);
  }

  .hub {
    position: relative;
    padding: 12px 20px;
    border-radius: 12px;
    border: 1px solid rgba(39, 196, 255, 0.6);
    background: rgba(39, 196, 255, 0.1);
    box-shadow: 0 0 24px -8px rgba(39, 196, 255, 0.7);
    font-weight: 580;
  }

  .hub::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 100%;
    width: 1px;
    height: 22px;
    background: linear-gradient(180deg, rgba(127, 227, 255, 0.1), rgba(127, 227, 255, 0.6));
  }

  /* convergence */
  .converge {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .inputs {
    flex: 1.4 1 0;
    display: grid;
    gap: 8px;
  }

  .inputs .chip {
    border-radius: 10px;
    padding: 9px 12px;
    font-size: 13.5px;
    color: var(--ink-2);
  }

  .converge .arrow {
    color: var(--cyan);
  }

  .box {
    flex: 1 1 0;
    padding: 16px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: rgba(10, 22, 44, 0.8);
    text-align: center;
    font-weight: 580;
  }

  .box.final {
    border-color: rgba(39, 196, 255, 0.7);
    background: rgba(39, 196, 255, 0.1);
    box-shadow: 0 0 24px -8px rgba(39, 196, 255, 0.6);
  }

  /* governance */
  .tiers {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
  }

  .tiers li {
    padding: 16px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: rgba(10, 22, 44, 0.8);
  }

  .tiers .go {
    border-color: rgba(61, 220, 151, 0.45);
  }

  .tiers .ask {
    border-color: rgba(255, 181, 71, 0.45);
  }

  .tiers .human {
    border-color: rgba(39, 196, 255, 0.65);
    box-shadow: 0 0 24px -10px rgba(39, 196, 255, 0.7);
  }

  /* observability */
  .states {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .state {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 10px 16px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: rgba(10, 22, 44, 0.8);
    font-weight: 520;
  }

  .state i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink-3);
  }

  .state.live i {
    background: var(--cyan);
    box-shadow: 0 0 8px var(--cyan);
  }

  .state.ok i {
    background: #3ddc97;
  }

  .state.bad i {
    background: #ff5a6a;
  }

  .state.ask i {
    background: #ffb547;
    box-shadow: 0 0 8px rgba(255, 181, 71, 0.6);
  }

  @media (max-width: 1240px) {
    .tiers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 1080px) {
    .doc {
      grid-template-columns: 1fr;
    }

    .toc {
      position: static;
    }

    .toc ol {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      border-left: 0;
    }

    .toc a {
      padding: 7px 14px 7px 10px;
      border-radius: 999px;
      border: 1px solid var(--line-2);
      font-size: 13.5px;
    }

    .toc a.is-active::before {
      display: none;
    }

    .steps.four,
    .cards.four {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .steps li:nth-child(2)::after {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .core ul,
    .steps.four,
    .cards.four,
    .tiers {
      grid-template-columns: 1fr;
    }

    .steps li:not(:last-child)::after {
      display: block;
      content: "↓";
      right: 50%;
      top: auto;
      bottom: -12px;
      transform: translate(50%, 50%);
    }

    .converge {
      flex-direction: column;
      align-items: stretch;
    }

    .converge .arrow {
      align-self: center;
      transform: rotate(90deg);
    }
  }
</style>
