---
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getJournal, formatDate } from "../../../lib/journal";

export async function getStaticPaths() {
  const entries = await getJournal();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} path={`/company/journal/${entry.id}`}>
  <article class="wrap post">
    <a class="back label" href="/company#journal">← Journal</a>
    <p class="label meta">{entry.data.kind} · <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time></p>
    <h1 class="h2">{entry.data.title}</h1>
    <p class="lede">{entry.data.description}</p>
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: calc(760px + var(--gutter) * 2);
    padding-top: clamp(120px, 14vw, 180px);
    padding-bottom: clamp(80px, 10vw, 140px);
  }

  .back {
    text-decoration: none;
    color: var(--cyan);
  }

  .meta {
    margin: 40px 0 18px;
  }

  .lede {
    margin-top: 24px;
  }

  .prose {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
    font-size: 18px;
    line-height: 1.7;
  }

  .prose :global(h2) {
    margin: 2em 0 0.6em;
    font-size: 26px;
    font-weight: 560;
    font-stretch: 108%;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .prose :global(p + p) {
    margin-top: 1.1em;
  }

  .prose :global(a) {
    color: var(--cyan-hi);
  }
</style>
