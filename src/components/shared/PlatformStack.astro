---
import type { StackLayer } from "../../data/types";

interface Props {
  layers: StackLayer[];
}
const { layers } = Astro.props;

// Isometric planes: each plane is a square in its own coordinates, mapped to screen with x' = x - y, y' = (x + y) / 2.
const S = 118; // half-size of a plane in plane coordinates
const Y0 = 132;
const GAP = layers.length > 4 ? 98 : 118;
const iso = (y: number) => `matrix(1 0.5 -1 0.5 300 ${y})`;

const r = (seed: number) => {
  let a = seed;
  return () => {
    a = (a * 16807) % 2147483647;
    return (a - 1) / 2147483646;
  };
};
const rand = r(11);
const kinds = ["#36c6ff", "#4fd8b0", "#f3b968", "#d6e2ff", "#8f86ff", "#ff7aa8"];
const cerebroDots = Array.from({ length: 26 }, (_, i) => {
  const a = rand() * Math.PI * 2;
  const d = 18 + rand() * 82;
  return { x: Math.cos(a) * d, y: Math.sin(a) * d, c: kinds[i % kinds.length], s: i < 6 ? 3.4 : 2 };
});
const cerebroLinks: [number, number][] = [];
cerebroDots.forEach((p, i) => {
  let best = -1;
  let bd = Infinity;
  cerebroDots.forEach((q, j) => {
    if (j === i) return;
    const d = (p.x - q.x) ** 2 + (p.y - q.y) ** 2;
    if (d < bd) {
      bd = d;
      best = j;
    }
  });
  if (best > i || !cerebroLinks.some(([a, b]) => a === best && b === i)) cerebroLinks.push([i, best]);
});
const managers = [
  { x: -62, y: -40 },
  { x: 54, y: -52 },
  { x: 0, y: 62 },
];
---

<div class="stack-grid" data-platform>
      <figure class="stack reveal" style="--d: 100ms" aria-hidden="true">
        <svg viewBox={`0 0 600 ${Y0 + GAP * (layers.length - 1) + 140}`} role="presentation">
          <defs>
            <linearGradient id="pf-fill" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="rgba(40,110,220,0.28)" />
              <stop offset="1" stop-color="rgba(6,16,34,0.08)" />
            </linearGradient>
            <linearGradient id="pf-fill-on" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="rgba(60,170,255,0.42)" />
              <stop offset="1" stop-color="rgba(10,40,90,0.2)" />
            </linearGradient>
            <linearGradient id="pf-beam" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="rgba(127,227,255,0)" />
              <stop offset="0.5" stop-color="rgba(127,227,255,0.9)" />
              <stop offset="1" stop-color="rgba(127,227,255,0)" />
            </linearGradient>
            <radialGradient id="pf-glow">
              <stop offset="0" stop-color="rgba(39,196,255,0.35)" />
              <stop offset="1" stop-color="rgba(39,196,255,0)" />
            </radialGradient>
          </defs>

          <ellipse cx="300" cy={Y0 + GAP * ((layers.length - 1) / 2)} rx="300" ry="220" fill="url(#pf-glow)" opacity="0.5" />

          {/* the stack's edges */}
          <g class="edges">
            <line x1={300 - 2 * S} y1={Y0} x2={300 - 2 * S} y2={Y0 + GAP * (layers.length - 1)} />
            <line x1={300 + 2 * S} y1={Y0} x2={300 + 2 * S} y2={Y0 + GAP * (layers.length - 1)} />
            <line x1="300" y1={Y0 + S} x2="300" y2={Y0 + GAP * (layers.length - 1) + S} />
          </g>

          {
            [...layers].reverse().map((layer, ri) => {
              const i = layers.length - 1 - ri;
              const y = Y0 + i * GAP;
              return (
                <g class="plane" data-layer={layer.id}>
                  <g transform={iso(y)}>
                    <rect class="plane-face" x={-S} y={-S} width={S * 2} height={S * 2} rx="10" />
                    <rect class="plane-inset" x={-S + 10} y={-S + 10} width={S * 2 - 20} height={S * 2 - 20} rx="6" />
                    {layer.art === "tiles" && (
                      <g class="art">
                        {[0, 1, 2].map((cx) =>
                          [0, 1].map((cy) => (
                            <rect
                              class={cx === 1 && cy === 0 ? "tile tile-on" : "tile"}
                              x={-92 + cx * 64}
                              y={-80 + cy * 84}
                              width="54"
                              height={cy === 0 ? 72 : 64}
                              rx="5"
                            />
                          )),
                        )}
                        <line class="ink" x1="-92" y1="84" x2="96" y2="84" />
                        <line class="ink" x1="-92" y1="96" x2="20" y2="96" />
                      </g>
                    )}
                    {layer.art === "orbit" && (
                      <g class="art">
                        <circle class="orbit" r="78" />
                        <circle class="orbit" r="44" />
                        {[0, 1, 2, 3, 4].map((k) => {
                          const a = (k / 5) * Math.PI * 2 - Math.PI / 2;
                          return (
                            <g>
                              <line class="spoke" x1="0" y1="0" x2={Math.cos(a) * 78} y2={Math.sin(a) * 78} />
                              <circle class="sat" cx={Math.cos(a) * 78} cy={Math.sin(a) * 78} r="6" />
                            </g>
                          );
                        })}
                        <circle class="core" r="13" />
                      </g>
                    )}
                    {layer.art === "teams" && (
                      <g class="art">
                        {managers.map((m, mi) => (
                          <g>
                            {[0, 1, 2, 3].map((k) => {
                              const a = (k / 4) * Math.PI * 2 + mi;
                              const ax = m.x + Math.cos(a) * 26;
                              const ay = m.y + Math.sin(a) * 26;
                              return (
                                <g>
                                  <line class="spoke" x1={m.x} y1={m.y} x2={ax} y2={ay} />
                                  <circle class="agent" cx={ax} cy={ay} r="3.2" />
                                </g>
                              );
                            })}
                            <circle class="mgr" cx={m.x} cy={m.y} r="7.5" />
                          </g>
                        ))}
                        <line class="ink" x1={managers[0].x} y1={managers[0].y} x2={managers[1].x} y2={managers[1].y} />
                        <line class="ink" x1={managers[1].x} y1={managers[1].y} x2={managers[2].x} y2={managers[2].y} />
                        <line class="ink" x1={managers[2].x} y1={managers[2].y} x2={managers[0].x} y2={managers[0].y} />
                      </g>
                    )}
                    {layer.art === "cluster" && (
                      <g class="art">
                        {cerebroLinks.map(([a, b]) => (
                          <line class="link" x1={cerebroDots[a].x} y1={cerebroDots[a].y} x2={cerebroDots[b].x} y2={cerebroDots[b].y} />
                        ))}
                        {cerebroDots.map((p) => (
                          <circle class="dot" cx={p.x} cy={p.y} r={p.s} fill={p.c} />
                        ))}
                      </g>
                    )}
                    {layer.art === "rails" && (
                      <g class="art">
                        {[0, 1, 2, 3, 4].map((k) => (
                          <g>
                            <line class="rail" x1="-96" y1={-72 + k * 36} x2="96" y2={-72 + k * 36} />
                            <rect
                              class="run"
                              x="-96"
                              y={-72 + k * 36 - 4}
                              width="30"
                              height="8"
                              rx="4"
                              style={`--dur:${5 + k * 1.3}s; --delay:${-k * 1.7}s`}
                            />
                          </g>
                        ))}
                      </g>
                    )}
                  </g>
                </g>
              );
            })
          }

          {/* light moving between layers: direction flows down, records flow back up */}
          <g class="beams">
            <rect class="beam beam-down" x="299" y={Y0} width="2" height="70" fill="url(#pf-beam)" />
            <rect class="beam beam-up" x={300 - 2 * S - 1} y={Y0} width="2" height="60" fill="url(#pf-beam)" />
            <rect class="beam beam-up b2" x={300 + 2 * S - 1} y={Y0} width="2" height="60" fill="url(#pf-beam)" />
          </g>
        </svg>
      </figure>

      <ol class="layers">
        {
          layers.map((layer, i) => (
            <li class="layer reveal" data-layer-item={layer.id} style={`--d: ${160 + i * 70}ms`}>
              <span class="n label">0{i + 1}</span>
              <div>
                <p class="layer-name">
                  {layer.name} <span>{layer.role}</span>
                </p>
                <p class="layer-text">{layer.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-platform]");
  if (root) {
    const items = [...root.querySelectorAll<HTMLElement>("[data-layer-item]")];
    const planes = new Map([...root.querySelectorAll<SVGGElement>("[data-layer]")].map((g) => [g.dataset.layer!, g]));
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let current = "";
    let auto = 0;
    let hovering = false;
    const set = (id: string) => {
      if (id === current) return;
      current = id;
      root.dataset.active = id;
      items.forEach((it) => it.classList.toggle("is-on", it.dataset.layerItem === id));
      planes.forEach((g, gid) => g.classList.toggle("is-on", gid === id));
    };
    items.forEach((it) => {
      it.addEventListener("pointerenter", () => {
        hovering = true;
        set(it.dataset.layerItem!);
      });
      it.addEventListener("pointerleave", () => (hovering = false));
    });
    set(items[0].dataset.layerItem!);
    if (!reduce) {
      const ids = items.map((i) => i.dataset.layerItem!);
      const io = new IntersectionObserver(
        ([e]) => {
          clearInterval(auto);
          if (e.isIntersecting) {
            auto = window.setInterval(() => {
              if (hovering) return;
              set(ids[(ids.indexOf(current) + 1) % ids.length]);
            }, 3200);
          }
        },
        { threshold: 0.3 },
      );
      io.observe(root);
    }
  }
</script>

<style>
  .stack-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }

  .stack {
    margin: 0;
  }

  .stack svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .edges line {
    stroke: rgba(110, 190, 255, 0.16);
    stroke-width: 1;
    stroke-dasharray: 2 5;
  }

  .plane-face {
    fill: url(#pf-fill);
    stroke: rgba(110, 190, 255, 0.32);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    transition: fill 500ms var(--ease), stroke 500ms var(--ease);
  }

  .plane-inset {
    fill: none;
    stroke: rgba(110, 190, 255, 0.1);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .plane {
    transition: opacity 600ms var(--ease);
  }

  .plane .art {
    opacity: 0.55;
    transition: opacity 600ms var(--ease);
  }

  [data-active] .plane:not(.is-on) {
    opacity: 0.62;
  }

  .plane.is-on .plane-face {
    fill: url(#pf-fill-on);
    stroke: rgba(127, 227, 255, 0.85);
  }

  .plane.is-on .art {
    opacity: 1;
  }

  .tile {
    fill: rgba(80, 160, 255, 0.1);
    stroke: rgba(110, 190, 255, 0.4);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .tile-on {
    fill: rgba(39, 196, 255, 0.28);
    stroke: rgba(127, 227, 255, 0.9);
  }

  .ink,
  .spoke {
    stroke: rgba(150, 210, 255, 0.45);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .orbit {
    fill: none;
    stroke: rgba(110, 190, 255, 0.3);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .core {
    fill: #eaf7ff;
    filter: drop-shadow(0 0 6px rgba(127, 227, 255, 0.9));
  }

  .sat,
  .mgr {
    fill: #36c6ff;
  }

  .mgr {
    fill: #8f86ff;
  }

  .agent {
    fill: #d6e2ff;
  }

  .link {
    stroke: rgba(130, 200, 255, 0.35);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .rail {
    stroke: rgba(110, 190, 255, 0.28);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .run {
    fill: rgba(127, 227, 255, 0.85);
    animation: run var(--dur) linear infinite;
    animation-delay: var(--delay);
  }

  @keyframes run {
    from {
      transform: translateX(0);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    to {
      transform: translateX(162px);
      opacity: 0;
    }
  }

  .beam {
    animation: beam-down 4.2s var(--ease) infinite;
  }

  .beam-up {
    animation-name: beam-up;
    animation-duration: 5.2s;
  }

  .b2 {
    animation-delay: -2.4s;
  }

  @keyframes beam-down {
    from {
      transform: translateY(-40px);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    to {
      transform: translateY(400px);
      opacity: 0;
    }
  }

  @keyframes beam-up {
    from {
      transform: translateY(400px);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    to {
      transform: translateY(-20px);
      opacity: 0;
    }
  }

  .layers {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .layer {
    position: relative;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 12px;
    padding: 22px 0 22px 0;
    border-bottom: 1px solid var(--line);
    transition: background 400ms var(--ease);
  }

  .layer::before {
    content: "";
    position: absolute;
    left: 0;
    top: -1px;
    height: 1px;
    width: 0;
    background: linear-gradient(90deg, var(--cyan), rgba(39, 196, 255, 0));
    transition: width 700ms var(--ease-out);
  }

  .layer.is-on::before {
    width: 100%;
  }

  .layer .n {
    padding-top: 5px;
    transition: color 400ms var(--ease);
  }

  .layer.is-on .n {
    color: var(--cyan);
  }

  .layer-name {
    font-size: 21px;
    font-weight: 580;
    font-stretch: 108%;
    letter-spacing: -0.015em;
    line-height: 1.25;
    color: var(--ink);
  }

  .layer-name span {
    display: inline-block;
    margin-left: 8px;
    font-size: 14px;
    font-weight: 450;
    font-stretch: 100%;
    letter-spacing: 0;
    color: var(--ink-3);
  }

  .layer-text {
    margin-top: 6px;
    font-size: 15.5px;
    color: var(--ink-2);
    max-width: 44ch;
  }

  @media (max-width: 960px) {
    .stack-grid {
      grid-template-columns: 1fr;
    }

    .stack {
      max-width: 520px;
      margin-inline: auto;
      width: 100%;
    }
  }

  @media (max-width: 560px) {
    .layer-name span {
      display: block;
      margin: 2px 0 0;
    }
  }
</style>
