---
/** Technology → Businesses → Results → Learning → Technology, turning continuously. */
import { globalCopy } from "../../content/global";
import { edit, type Field } from "../../content/schema";

interface Props {
  /** Optional lines in the middle of the ring. */
  center?: Field<string[]>;
}
const { center } = Astro.props;
const c = globalCopy.cycle;
const lines = center?.text ?? [];
---

<figure class="cycle" role="img" aria-label={`${c.technology.text}, ${c.businesses.text}, ${c.results.text}, ${c.learning.text}, and back to ${c.technology.text}`}>
  <svg viewBox="0 0 440 320">
    <circle class="arc" cx="220" cy="160" r="104" />
    <circle class="arc dim" cx="220" cy="160" r="122" />
    <circle class="travel" r="4">
      <animateMotion dur="9s" repeatCount="indefinite" path="M 220 56 A 104 104 0 1 1 219.9 56" />
    </circle>
    <g class="n"><circle cx="220" cy="56" r="7" /><text x="220" y="30" text-anchor="middle" {...edit(c.technology, "label")}>{c.technology.text}</text></g>
    <g class="n"><circle cx="324" cy="160" r="7" /><text x="346" y="164" text-anchor="start" {...edit(c.businesses, "label")}>{c.businesses.text}</text></g>
    <g class="n"><circle cx="220" cy="264" r="7" /><text x="220" y="298" text-anchor="middle" {...edit(c.results, "label")}>{c.results.text}</text></g>
    <g class="n"><circle cx="116" cy="160" r="7" /><text x="94" y="164" text-anchor="end" {...edit(c.learning, "label")}>{c.learning.text}</text></g>
    {center && lines.map((line, n) => (
      <text class="mid" x="220" y={165 - ((lines.length - 1) * 18) / 2 + n * 18} text-anchor="middle" {...edit(center, "list")}>{line}</text>
    ))}
  </svg>
</figure>

<style>
  .cycle {
    margin: 0;
  }

  .cycle svg {
    width: 100%;
    max-width: 440px;
    margin-inline: auto;
    overflow: visible;
  }

  .arc {
    fill: none;
    stroke: rgba(110, 190, 255, 0.45);
    stroke-width: 1.2;
  }
  .arc.dim {
    stroke: rgba(110, 190, 255, 0.18);
    stroke-dasharray: 3 5;
  }
  .travel {
    fill: #eafaff;
    filter: drop-shadow(0 0 6px rgba(127, 227, 255, 0.9));
  }
  .mid {
    font-family: var(--font-sans);
    font-size: 13px;
    fill: var(--ink-3);
  }
  .n circle {
    fill: var(--bg-2);
    stroke: var(--cyan);
    stroke-width: 1.4;
  }
  .n text {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: var(--ink-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .travel {
      display: none;
    }
  }
</style>
