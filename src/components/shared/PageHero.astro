---
/** Hero for inner pages: eyebrow, title, body paragraphs, calls to action, and a page-specific backdrop slot. */
import { edit, type Field } from "../../content/schema";

interface Props {
  copy: { eyebrow: Field; title: Field; body: Field<string[]>; primary: Field; secondary?: Field };
  /** Destination of the main button, and of the optional second button. */
  primary: string;
  secondary?: string;
  tone?: "company" | "platform" | "businesses" | "technology";
}
const { copy, primary, secondary, tone = "company" } = Astro.props;
const arrow = `<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<section class:list={["page-hero", `tone-${tone}`]} aria-labelledby="page-title">
  <div class="backdrop" aria-hidden="true"><slot name="backdrop" /></div>
  <div class="wrap inner">
    <p class="label kicker hero-in" style="--d: 80ms" {...edit(copy.eyebrow, "eyebrow")}>{copy.eyebrow.text}</p>
    <h1 class="display title hero-in" id="page-title" style="--d: 160ms" {...edit(copy.title, "heading", ["size", "width", "below"])}>{copy.title.text}</h1>
    <div class="copy hero-in" style="--d: 320ms" {...edit(copy.body, "paragraphs", ["width", "above", "below"])}>
      {copy.body.text.map((p, i) => <p class:list={["lede", { first: i === 0 }]}>{p}</p>)}
    </div>
    <div class="ctas hero-in" style="--d: 460ms">
      <a class="btn btn--primary" href={primary} {...edit(copy.primary, "cta", [], { href: primary })}>
        {copy.primary.text} <Fragment set:html={arrow} />
      </a>
      {
        secondary && copy.secondary && (
          <a class="btn btn--ghost" href={secondary} {...edit(copy.secondary, "cta", [], { href: secondary })}>
            {copy.secondary.text}
          </a>
        )
      }
    </div>
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(132px, 16vw, 200px) 0 clamp(72px, 9vw, 120px);
    border-bottom: 1px solid var(--line);
  }

  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .tone-company {
    background:
      radial-gradient(900px 520px at 78% 18%, rgba(139, 123, 255, 0.12), transparent 70%),
      radial-gradient(800px 500px at 10% 0%, rgba(39, 150, 255, 0.1), transparent 70%),
      var(--bg-0);
  }

  .tone-platform {
    background:
      radial-gradient(1000px 600px at 70% 30%, rgba(23, 92, 200, 0.22), transparent 70%),
      var(--bg-0);
  }

  .tone-businesses {
    background:
      radial-gradient(800px 500px at 85% 20%, rgba(39, 196, 255, 0.1), transparent 70%),
      radial-gradient(700px 500px at 15% 90%, rgba(139, 123, 255, 0.08), transparent 70%),
      var(--bg-0);
  }

  .tone-technology {
    background:
      radial-gradient(900px 520px at 50% 0%, rgba(39, 150, 255, 0.12), transparent 70%),
      linear-gradient(rgba(60, 170, 255, 0.035) 1px, transparent 1px) 0 0 / 44px 44px,
      linear-gradient(90deg, rgba(60, 170, 255, 0.035) 1px, transparent 1px) 0 0 / 44px 44px,
      var(--bg-1);
  }

  .title {
    --fs: var(--type-page);
    font-size: var(--fs);
  }

  .title :global(span) {
    color: var(--ink-3);
  }

  .copy {
    --measure: 40em;
    margin-top: 32px;
    max-width: var(--measure);
  }

  .copy .lede + .lede {
    margin-top: 1em;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }

  .js .hero-in {
    animation: page-in 1100ms var(--ease-out) both;
    animation-delay: var(--d, 0ms);
  }

  @keyframes page-in {
    from {
      opacity: 0;
      transform: translate3d(0, 22px, 0);
    }
  }
</style>
