---
import { home } from "../../content/home";
import { edit, parts } from "../../content/schema";

const c = home.technology;
const arrow = `<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
/** Where each card leads, in the order of the cards in home.json. */
const hrefs = [
  "/technology#execution",
  "/technology#agents",
  "/technology#knowledge",
  "/technology#knowledge",
  "/technology#governance",
  "/technology#integrations",
  "/technology#observability",
  "/technology#reliability",
];
---

<section class="section tech" id="technology" aria-labelledby="tech-title">
  <div class="wrap">
    <div class="head">
      <div class="section-head reveal">
        <p class="label kicker" {...edit(c.eyebrow, "eyebrow")}>{c.eyebrow.text}</p>
        <h2 class="h2" id="tech-title" {...edit(c.headline, "heading", ["size", "above", "below"])}>{c.headline.text}</h2>
        {parts(c.body).map(({ text, part }) => <p class="lede" {...edit(c.body, "paragraphs", ["width", "above", "below"], { part })}>{text}</p>)}
        <p class="closing" {...edit(c.closing, "text", ["above", "below"])}>{c.closing.text}</p>
      </div>
      <a class="btn btn--ghost cta reveal" href="/technology" {...edit(c.cta, "cta", [], { href: "/technology" })}>{c.cta.text} <Fragment set:html={arrow} /></a>
    </div>

    <ol class="spec">
      {
        c.items.map((it, i) => (
          <li class="reveal" style={`--d: ${(i % 4) * 60}ms`}>
            <a class="cell" href={hrefs[i]}>
              <span class="label idx">{String(i + 1).padStart(2, "0")}</span>
              <h3 {...edit(it.title, "heading", [], { href: hrefs[i] })}>{it.title.text}</h3>
              <p {...edit(it.body, "text", [], { href: hrefs[i] })}>{it.body.text}</p>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .tech {
    background:
      radial-gradient(900px 500px at 50% 0%, rgba(39, 150, 255, 0.08), transparent 70%),
      linear-gradient(rgba(60, 170, 255, 0.028) 1px, transparent 1px) 0 0 / 44px 44px,
      linear-gradient(90deg, rgba(60, 170, 255, 0.028) 1px, transparent 1px) 0 0 / 44px 44px,
      var(--bg-1);
    border-block: 1px solid var(--line);
  }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }

  .cta {
    flex: none;
  }

  .section-head .lede + .lede {
    margin-top: 1em;
  }

  .closing {
    margin-top: 24px;
    font-size: clamp(19px, 1.7vw, 23px);
    font-weight: 540;
    font-stretch: 106%;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .spec {
    list-style: none;
    margin: clamp(48px, 6vw, 72px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line-2);
    border-left: 1px solid var(--line);
  }

  .cell {
    position: relative;
    display: block;
    height: 100%;
    padding: 24px 24px 28px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: rgba(2, 4, 10, 0.55);
    text-decoration: none;
    transition: background 400ms var(--ease);
  }

  .cell::before {
    content: "";
    position: absolute;
    left: -1px;
    top: -1px;
    width: 0;
    height: 1px;
    background: var(--cyan);
    box-shadow: 0 0 10px var(--cyan);
    transition: width 600ms var(--ease-out);
  }

  .cell:hover {
    background: rgba(10, 24, 50, 0.6);
  }

  .cell:hover::before {
    width: 48px;
  }

  .idx {
    color: var(--cyan);
  }

  .cell h3 {
    margin: 14px 0 0;
    font-size: 18.5px;
    font-weight: 580;
    font-stretch: 106%;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .cell p {
    margin-top: 8px;
    font-size: 14.5px;
    color: var(--ink-2);
  }

  @media (max-width: 960px) {
    .spec {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .spec {
      grid-template-columns: 1fr;
    }
  }
</style>
