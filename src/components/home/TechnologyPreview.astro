---
import { home } from "../../content/home";
import { edit, parts } from "../../content/schema";

const c = home.technology;
const [first, ...more] = parts(c.body);
const arrow = `<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
/** Where each card leads, in the order of the cards in home.json. */
const hrefs = [
  "/technology#execution",
  "/technology#agents",
  "/technology#knowledge",
  "/technology#knowledge",
  "/technology#governance",
  "/technology#integrations",
  "/technology#observability",
  "/technology#reliability",
];
---

<section class="section tech" id="technology" aria-labelledby="tech-title">
  <div class="wrap">
    <div class="head">
      <div class="section-head reveal">
        <p class="label kicker" {...edit(c.eyebrow, "eyebrow")}>{c.eyebrow.text}</p>
        <h2 class="h2" id="tech-title" {...edit(c.headline, "heading", ["size", "above", "below"])}>{c.headline.text}</h2>
      </div>
      <div class="copy copy--first reveal">
        {first && <p class="lede" {...edit(c.body, "paragraphs", ["width", "above", "below"], { part: first.part })}>{first.text}</p>}
        <p class="closing" {...edit(c.closing, "text", ["above", "below"])}>{c.closing.text}</p>
      </div>
      <div class="copy copy--more reveal">
        {more.map(({ text, part }) => <p class="lede" {...edit(c.body, "paragraphs", ["width", "above", "below"], { part })}>{text}</p>)}
        <a class="btn btn--ghost cta" href="/technology" {...edit(c.cta, "cta", [], { href: "/technology" })}>{c.cta.text} <Fragment set:html={arrow} /></a>
      </div>
    </div>

    <ol class="spec">
      {
        c.items.map((it, i) => (
          <li class="reveal" style={`--d: ${(i % 4) * 60}ms`}>
            <a class="cell" href={hrefs[i]}>
              <span class="label idx">{String(i + 1).padStart(2, "0")}</span>
              <h3 {...edit(it.title, "heading", [], { href: hrefs[i] })}>{it.title.text}</h3>
              <p {...edit(it.body, "text", [], { href: hrefs[i] })}>{it.body.text}</p>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .tech {
    background:
      radial-gradient(900px 500px at 50% 0%, rgba(39, 150, 255, 0.08), transparent 70%),
      linear-gradient(rgba(60, 170, 255, 0.028) 1px, transparent 1px) 0 0 / 44px 44px,
      linear-gradient(90deg, rgba(60, 170, 255, 0.028) 1px, transparent 1px) 0 0 / 44px 44px,
      var(--bg-1);
    border-block: 1px solid var(--line);
  }

  /* The headline runs across the top at its own measure. Below it, two columns that start level: the first paragraph
     and the closing line on the left; the rest of the copy and the CTA on the right.
     The left column is a little narrower, so the shorter left copy and the longer right copy run to similar heights.
     Tablets and phones stack everything in reading order. */
  .head {
    display: grid;
    grid-template-columns: minmax(0, 9fr) minmax(0, 11fr);
    column-gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .section-head {
    grid-column: 1 / -1;
  }

  .copy {
    margin-top: 28px;
  }

  .copy--first {
    grid-area: 2 / 1;
  }

  .copy--more {
    grid-area: 2 / 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .copy .lede + .lede {
    margin-top: 1em;
  }

  .closing {
    margin-top: 24px;
    font-size: clamp(19px, 1.7vw, 23px);
    font-weight: 540;
    font-stretch: 106%;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: balance;
  }

  .cta {
    margin-top: 30px;
  }

  /* The right column takes the first paragraph's spacing step, so both columns start level. */
  @media (min-width: 961px) {
    .head:has(> .copy--first > .lede[data-v-above="looser"]) > .copy--more {
      padding-top: var(--v-space-looser);
    }

    .head:has(> .copy--first > .lede[data-v-above="tighter"]) > .copy--more {
      translate: 0 calc(var(--v-space-tighter) * -1);
    }
  }

  @media (max-width: 960px) {
    .head {
      grid-template-columns: minmax(0, 1fr);
    }

    .copy--first,
    .copy--more {
      grid-area: auto;
    }

    .copy--more {
      margin-top: 0;
    }

    .copy--more > .lede:first-child {
      margin-top: 24px;
    }
  }

  .spec {
    list-style: none;
    margin: clamp(56px, 7vw, 96px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line-2);
    border-left: 1px solid var(--line);
  }

  .cell {
    position: relative;
    display: block;
    height: 100%;
    padding: 24px 24px 28px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: rgba(2, 4, 10, 0.55);
    text-decoration: none;
    transition: background 400ms var(--ease);
  }

  .cell::before {
    content: "";
    position: absolute;
    left: -1px;
    top: -1px;
    width: 0;
    height: 1px;
    background: var(--cyan);
    box-shadow: 0 0 10px var(--cyan);
    transition: width 600ms var(--ease-out);
  }

  .cell:hover {
    background: rgba(10, 24, 50, 0.6);
  }

  .cell:hover::before {
    width: 48px;
  }

  .idx {
    color: var(--cyan);
  }

  .cell h3 {
    margin: 14px 0 0;
    font-size: 18.5px;
    font-weight: 580;
    font-stretch: 106%;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .cell p {
    margin-top: 8px;
    font-size: 14.5px;
    color: var(--ink-2);
  }

  @media (max-width: 960px) {
    .spec {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .spec {
      grid-template-columns: 1fr;
    }
  }
</style>
