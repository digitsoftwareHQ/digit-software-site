---
const reserved = [
  { t: "Money", d: "Material spending and financial commitments." },
  { t: "Security", d: "Access, credentials, permissions, and sensitive changes." },
  { t: "Direction", d: "Strategy and decisions that materially change the business." },
  { t: "External Actions", d: "Important actions that represent or commit the business." },
  { t: "Irreversible Actions", d: "Decisions that cannot easily be undone." },
];
---

<section class="section governance" id="autonomy" aria-labelledby="governance-title">
  <div class="wrap">
    <div class="authority">
      <div class="auth-copy reveal">
        <p class="label kicker">Autonomy</p>
        <h2 class="h2" id="governance-title">Autonomy with limits.</h2>
        <p class="body big">
          Digit can handle routine work without waiting for approval at every step. Some decisions still belong with the
          people responsible for the business.
        </p>
        <p class="body">
          Spending, security, company direction, external commitments, and actions that are difficult to reverse can require
          a person before anything happens. The software operates within those limits.
        </p>
      </div>

      <div class="auth-side reveal" style="--d: 120ms">
        <ul class="reserved">
          {
            reserved.map((r) => (
              <li>
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <rect x="3.5" y="7" width="9" height="6.5" rx="1.5" />
                  <path d="M5.5 7V5.2a2.5 2.5 0 0 1 5 0V7" />
                </svg>
                <div>
                  <p>{r.t}</p>
                  <span>{r.d}</span>
                </div>
              </li>
            ))
          }
        </ul>
        <ol class="flow" aria-label="Decision flow">
          <li><b>System</b> prepares</li>
          <li><b>Person</b> decides</li>
          <li><b>System</b> acts</li>
          <li><b>Outcome</b> is recorded</li>
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .governance {
    background:
      radial-gradient(700px 500px at 88% 50%, rgba(23, 92, 200, 0.12), transparent 70%),
      var(--bg-0);
  }

  .authority {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .auth-copy .big {
    margin-top: 28px;
  }
  .axiom {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 22px;
    font-weight: 560;
    font-stretch: 110%;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .auth-side {
    padding: 28px;
    border-radius: 20px;
    border: 1px solid var(--glass-edge);
    background: linear-gradient(170deg, rgba(14, 30, 60, 0.6), rgba(5, 11, 24, 0.6));
  }
  .reserved {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .reserved li {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 12px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
  }

  .reserved li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .reserved svg {
    width: 16px;
    height: 16px;
    margin-top: 3px;
    fill: none;
    stroke: var(--cyan);
    stroke-width: 1.4;
  }
  .reserved p {
    font-weight: 560;
  }
  .reserved span {
    display: block;
    margin-top: 2px;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .flow {
    list-style: none;
    margin: 22px 0 0;
    padding: 18px 0 0;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    counter-reset: f;
  }
  .flow li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 999px;
    font-size: 13px;
    color: var(--ink-2);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--line);
  }
  .flow b {
    color: var(--ink);
    font-weight: 600;
  }
  .flow li:not(:last-child)::after {
    content: "→";
    margin-left: 6px;
    color: var(--cyan);
  }
  .big {
    font-size: clamp(18px, 1.5vw, 20px);
    color: var(--ink);
    line-height: 1.55;
  }
  .big + .body {
    margin-top: 14px;
  }

  @media (max-width: 860px) {
    .authority {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .auth-side {
      padding: 22px;
    }
  }
</style>
