---
import PlatformStack from "../shared/PlatformStack.astro";
import type { StackLayer } from "../../data/types";
import { home } from "../../content/home";
import { edit, parts } from "../../content/schema";

const c = home.platform;
const [first, ...more] = parts(c.body);
const arrow = `<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const layers: StackLayer[] = [
  { id: "mission-control", ...c.layers["mission-control"], art: "tiles", href: "/platform#mission-control", ariaLabel: "View Mission Control" },
  { id: "agents", ...c.layers.agents, art: "teams", href: "/technology#agents" },
  { id: "cerebro", ...c.layers.cerebro, art: "cluster", href: "/platform#cerebro", ariaLabel: "View Cerebro" },
  { id: "execution", ...c.layers.execution, art: "rails", href: "/technology#execution", ariaLabel: "View execution layer" },
];
---

<section class="section platform" id="platform" aria-labelledby="platform-title">
  <div class="wrap">
    <div class="head">
      <div class="section-head reveal">
        <p class="label kicker" {...edit(c.eyebrow, "eyebrow")}>{c.eyebrow.text}</p>
        <h2 class="h2" id="platform-title" {...edit(c.headline, "heading", ["size", "above", "below"])}>{c.headline.text}</h2>
      </div>
      <div class="copy copy--first reveal">
        {first && <p class="lede" {...edit(c.body, "paragraphs", ["width", "above", "below"], { part: first.part })}>{first.text}</p>}
      </div>
      <div class="copy copy--more reveal">
        {more.map(({ text, part }) => <p class="lede" {...edit(c.body, "paragraphs", ["width", "above", "below"], { part })}>{text}</p>)}
        <a class="btn btn--ghost cta" href="/platform" {...edit(c.cta, "cta", [], { href: "/platform" })}>{c.cta.text} <Fragment set:html={arrow} /></a>
      </div>
    </div>

    <div class="stack-wrap">
      <PlatformStack layers={layers} />
    </div>
  </div>
</section>

<style>
  .platform {
    background:
      radial-gradient(800px 500px at 20% 30%, rgba(23, 92, 200, 0.1), transparent 70%),
      var(--bg-0);
  }

  /* The headline runs across the top at its own measure. Below it, two columns that start level: the first paragraph on
     the left; the rest of the copy and the CTA on the right.
     The left column is a little narrower, so the shorter left copy and the longer right copy run to similar heights.
     Tablets and phones stack everything in reading order. */
  .head {
    display: grid;
    grid-template-columns: minmax(0, 9fr) minmax(0, 11fr);
    column-gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .section-head {
    grid-column: 1 / -1;
  }

  .copy {
    margin-top: 28px;
  }

  .copy--first {
    grid-area: 2 / 1;
  }

  .copy--more {
    grid-area: 2 / 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .copy .lede + .lede {
    margin-top: 1em;
  }

  .cta {
    margin-top: 30px;
  }

  /* The right column takes the first paragraph's spacing step, so both columns start level. */
  @media (min-width: 961px) {
    .head:has(> .copy--first > .lede[data-v-above="looser"]) > .copy--more {
      padding-top: var(--v-space-looser);
    }

    .head:has(> .copy--first > .lede[data-v-above="tighter"]) > .copy--more {
      translate: 0 calc(var(--v-space-tighter) * -1);
    }
  }

  @media (max-width: 960px) {
    .head {
      grid-template-columns: minmax(0, 1fr);
    }

    .copy--first,
    .copy--more {
      grid-area: auto;
    }

    .copy--more {
      margin-top: 0;
    }

    .copy--more > .lede:first-child {
      margin-top: 1em;
    }
  }

  .stack-wrap {
    margin-top: clamp(56px, 7vw, 96px);
  }
</style>
