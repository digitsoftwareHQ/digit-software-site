---
import PlatformStack from "../shared/PlatformStack.astro";
import type { StackLayer } from "../../data/types";
import { home } from "../../content/home";
import { edit, parts } from "../../content/schema";

const c = home.platform;
const arrow = `<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const layers: StackLayer[] = [
  { id: "mission-control", ...c.layers["mission-control"], art: "tiles", href: "/platform#mission-control", ariaLabel: "View Mission Control" },
  { id: "agents", ...c.layers.agents, art: "teams", href: "/technology#agents" },
  { id: "cerebro", ...c.layers.cerebro, art: "cluster", href: "/platform#cerebro", ariaLabel: "View Cerebro" },
  { id: "execution", ...c.layers.execution, art: "rails", href: "/technology#execution", ariaLabel: "View execution layer" },
];
---

<section class="section platform" id="platform" aria-labelledby="platform-title">
  <div class="wrap">
    <div class="head">
      <div class="section-head reveal">
        <p class="label kicker" {...edit(c.eyebrow, "eyebrow")}>{c.eyebrow.text}</p>
        <h2 class="h2" id="platform-title" {...edit(c.headline, "heading", ["size", "above", "below"])}>{c.headline.text}</h2>
        {parts(c.body).map(({ text, part }) => <p class="lede" {...edit(c.body, "paragraphs", ["width", "above", "below"], { part })}>{text}</p>)}
      </div>
      <a class="btn btn--ghost cta reveal" href="/platform" {...edit(c.cta, "cta", [], { href: "/platform" })}>{c.cta.text} <Fragment set:html={arrow} /></a>
    </div>

    <div class="stack-wrap">
      <PlatformStack layers={layers} />
    </div>
  </div>
</section>

<style>
  .platform {
    background:
      radial-gradient(800px 500px at 20% 30%, rgba(23, 92, 200, 0.1), transparent 70%),
      var(--bg-0);
  }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }

  .cta {
    flex: none;
  }

  .section-head .lede + .lede {
    margin-top: 1em;
  }

  .stack-wrap {
    margin-top: clamp(56px, 7vw, 96px);
  }
</style>
