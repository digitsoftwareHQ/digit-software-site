---
import PlatformStack from "../shared/PlatformStack.astro";
import type { StackLayer } from "../../data/types";

const arrow = `<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const layers: StackLayer[] = [
  {
    id: "mission-control",
    name: "Mission Control",
    role: "See the whole operation",
    text: "See what is happening across the business, what needs attention, how work is progressing, and where a decision is needed.",
    art: "tiles",
    href: "/platform#mission-control",
    ariaLabel: "View Mission Control",
  },
  {
    id: "agents",
    name: "Agents",
    role: "Specialized software at work",
    text: "Agents research, analyze, create, review, monitor, and carry out work across different parts of the business.",
    art: "teams",
    href: "/technology#agents",
  },
  {
    id: "cerebro",
    name: "Cerebro",
    role: "The brain behind the business",
    text: "Knowledge, evidence, experience, procedures, and decisions stay connected and available to the systems that need them.",
    art: "cluster",
    href: "/platform#cerebro",
    ariaLabel: "View Cerebro",
  },
  {
    id: "execution",
    name: "Execution",
    role: "Turn decisions into action",
    text: "The execution layer coordinates agents, connects them to the systems they need, and keeps track of what happens along the way.",
    art: "rails",
    href: "/technology#execution",
    ariaLabel: "View execution layer",
  },
];
---

<section class="section platform" id="platform" aria-labelledby="platform-title">
  <div class="wrap">
    <div class="head">
      <div class="section-head reveal">
        <p class="label kicker">Our Platform</p>
        <h2 class="h2" id="platform-title">Software that's intelligent enough to run businesses.</h2>
        <p class="lede">
          Most business software gives people tools to do their jobs. Ours is built to take on more of the work itself.
        </p>
        <p class="lede">
          The platform brings together specialized agents, software for coordinating their work, shared intelligence built
          from what the business learns, and the infrastructure needed to turn decisions into actions.
        </p>
      </div>
      <a class="btn btn--ghost cta reveal" href="/platform">Explore the Platform <Fragment set:html={arrow} /></a>
    </div>

    <div class="stack-wrap">
      <PlatformStack layers={layers} />
    </div>
  </div>
</section>

<style>
  .platform {
    background:
      radial-gradient(800px 500px at 20% 30%, rgba(23, 92, 200, 0.1), transparent 70%),
      var(--bg-0);
  }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }

  .cta {
    flex: none;
  }

  .section-head .lede + .lede {
    margin-top: 1em;
  }

  .stack-wrap {
    margin-top: clamp(56px, 7vw, 96px);
  }
</style>
