---
import { home } from "../../content/home";
import { edit, parts } from "../../content/schema";

const c = home.company;
const arrow = `<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<section class="section company" id="company" aria-labelledby="company-title">
  <div class="wrap grid">
    <div class="lead reveal">
      <p class="label kicker" {...edit(c.eyebrow, "eyebrow")}>{c.eyebrow.text}</p>
      <h2 class="h2" id="company-title" {...edit(c.headline, "heading", ["size", "above", "below"])}>{c.headline.text}</h2>
    </div>
    <div class="essay">
      <p class="first reveal" {...edit(c.lead, "text", ["size", "width", "above", "below"])}>{c.lead.text}</p>
      {parts(c.body).map(({ text, part }) => <p class="reveal" {...edit(c.body, "paragraphs", ["width", "above", "below"], { part })}>{text}</p>)}
      <a class="btn btn--ghost cta reveal" href="/company" {...edit(c.cta, "cta", [], { href: "/company" })}>{c.cta.text} <Fragment set:html={arrow} /></a>
    </div>
  </div>
</section>

<style>
  .company {
    background:
      radial-gradient(700px 500px at 85% 40%, rgba(139, 123, 255, 0.07), transparent 70%),
      var(--bg-0);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .essay p {
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.6;
    color: var(--ink-2);
    text-wrap: pretty;
    --measure: 32em;
    max-width: var(--measure);
  }

  .essay p + p {
    margin-top: 1em;
  }

  .essay .first {
    --fs: clamp(24px, 2.3vw, 32px);
    font-size: var(--fs);
    line-height: 1.32;
    font-weight: 500;
    font-stretch: 106%;
    letter-spacing: -0.016em;
    color: var(--ink);
    --measure: 22em;
    max-width: var(--measure);
  }

  .cta {
    margin-top: 40px;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
