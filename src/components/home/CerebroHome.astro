---
import { CLASSES } from "../../scripts/universe";
import { CLASS_INFO } from "../../data/cerebro-example";
---

<section class="section cerebro" id="cerebro" aria-labelledby="cerebro-title" data-cerebro-home>
  <div class="wrap grid">
    <div class="copy">
      <div class="reveal">
        <p class="label kicker">Cerebro</p>
        <h2 class="h2" id="cerebro-title">Intelligence that compounds.</h2>
        <p class="lede">
          Cerebro is Digit's institutional intelligence. It holds what the company knows, what it has tried, what happened
          and why, and it keeps all of it connected. Every decision can draw on what the company has already learned, and
          every outcome adds to it.
        </p>
      </div>
      <ul class="kinds reveal" style="--d: 120ms" aria-label="What Cerebro holds">
        {
          CLASSES.map((c) => (
            <li style={`--c: ${c.color}`}>
              <i />
              <span>{CLASS_INFO[c.key as keyof typeof CLASS_INFO].name}</span>
            </li>
          ))
        }
      </ul>
      <p class="note reveal" style="--d: 180ms">
        Six kinds of knowledge, each linked to the evidence behind it and to the decisions it has shaped.
      </p>
      <p class="more reveal" style="--d: 220ms">
        <a href="/platform#cerebro">Explore Cerebro <span aria-hidden="true">→</span></a>
      </p>
    </div>

    <div class="field" data-cerebro-home-field>
      <canvas aria-hidden="true" data-cerebro-home-canvas></canvas>
      <div class="u-tip" aria-hidden="true" data-cerebro-home-tip>
        <span class="u-tip-kind"><i></i><span data-kind></span></span>
        <span class="u-tip-title" data-title></span>
      </div>
    </div>
  </div>
</section>

<script>
  import { Universe, generateUniverse } from "../../scripts/universe";
  import { FOCUS_LABELS } from "../../data/cerebro-example";

  const section = document.querySelector<HTMLElement>("[data-cerebro-home]");
  const field = document.querySelector<HTMLElement>("[data-cerebro-home-field]");
  const canvas = document.querySelector<HTMLCanvasElement>("[data-cerebro-home-canvas]");
  const tip = document.querySelector<HTMLElement>("[data-cerebro-home-tip]");

  if (section && field && canvas) {
    const narrow = window.innerWidth < 760;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let universe: Universe | null = null;

    const progress = () => {
      const r = section.getBoundingClientRect();
      const t = (window.innerHeight * 0.92 - r.top) / (r.height * 0.75);
      return 0.1 + 0.9 * Math.min(1, Math.max(0, t));
    };

    const init = () => {
      universe = new Universe(canvas, {
        graph: generateUniverse({
          seed: 7310,
          count: narrow ? 150 : 230,
          weights: { knowledge: 1, evidence: 0.7, experience: 0.45, procedures: 0.7, organization: 0.5, governance: 0.35 },
        }),
        center: (W, H) => ({ x: W * 0.5, y: H * 0.5 }),
        radius: (W, H) => Math.min(W * 0.44, H * 0.48),
        yaw: 1.4,
        spin: 0.05,
        nebula: 0.9,
        growth: true,
        intro: false,
        focusEvery: 5200,
        focusLabels: [...FOCUS_LABELS],
        tip: narrow ? null : tip,
        pointerTarget: field,
        hoverFocus: !narrow,
      });
      universe.setGrowth(reduce ? 1 : progress());
    };

    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting && !universe) init();
      },
      { rootMargin: "300px 0px" },
    );
    io.observe(section);

    if (!reduce) {
      let ticking = false;
      window.addEventListener(
        "scroll",
        () => {
          if (ticking || !universe) return;
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            universe?.setGrowth(progress());
          });
        },
        { passive: true },
      );
    }
  }
</script>

<style>
  .cerebro {
    background:
      radial-gradient(900px 640px at 72% 50%, rgba(30, 80, 190, 0.2), transparent 70%),
      radial-gradient(500px 400px at 95% 20%, rgba(139, 123, 255, 0.08), transparent 70%),
      var(--bg-0);
    overflow: hidden;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
  }

  .copy .lede {
    margin-top: 28px;
  }

  .kinds {
    list-style: none;
    margin: 36px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px 20px;
    max-width: 480px;
  }

  .kinds li {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 15px;
    font-weight: 520;
    color: var(--ink);
  }

  .kinds i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 10px var(--c);
  }

  .note {
    margin-top: 18px;
    font-size: 15px;
    color: var(--ink-3);
    max-width: 34em;
  }

  .more {
    margin-top: 32px;
  }

  .more a {
    font-weight: 560;
    color: var(--cyan-hi);
    text-decoration: none;
    border-bottom: 1px solid rgba(127, 227, 255, 0.3);
    padding-bottom: 2px;
    transition: border-color var(--fast) var(--ease);
  }

  .more a:hover {
    border-color: var(--cyan-hi);
  }

  .field {
    position: relative;
    isolation: isolate;
    height: clamp(460px, 48vw, 680px);
    margin-right: calc(var(--gutter) * -1);
  }

  .field canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .field {
      height: 420px;
      margin: 8px calc(var(--gutter) * -1) 0;
    }
  }
</style>
