---
import { LEGAL_NAV, NAV } from "../data/site";
import { globalCopy } from "../content/global";
import { edit } from "../content/schema";
const c = globalCopy.footer;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div class="about">
        <a class="brand" href="/" aria-label="Go to homepage">
          <img src="/assets/digit-mark.svg" alt="" width="24" height="24" loading="lazy" />
          <span>Digit <span>Software</span></span>
        </a>
        <p {...edit(c.description, "text")}>{c.description.text}</p>
      </div>
      <nav class="col" aria-label="Navigation">
        <p class="label" {...edit(c.navigationLabel, "label")}>{c.navigationLabel.text}</p>
        <ul>
          {NAV.map((l) => (
            <li><a href={l.href} {...edit(globalCopy.nav[l.key], "label", [], { href: l.href })}>{globalCopy.nav[l.key].text}</a></li>
          ))}
        </ul>
      </nav>
      <nav class="col" aria-label="Legal">
        <p class="label" {...edit(c.legalLabel, "label")}>{c.legalLabel.text}</p>
        <ul>
          {LEGAL_NAV.map((l) => (
            <li><a href={l.href} {...edit(c[l.key], "label", [], { href: l.href })}>{c[l.key].text}</a></li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="bottom">
      <p {...edit(c.copyright, "text")}>&copy; {year} {c.copyright.text}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    border-top: 1px solid var(--line);
    padding: 72px 0 40px;
    background: linear-gradient(180deg, var(--bg-0), #01030a);
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr));
    gap: 40px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 650;
    font-stretch: 114%;
    letter-spacing: -0.02em;
  }

  .brand img {
    width: 24px;
    height: 24px;
  }

  .brand > span > span {
    font-weight: 450;
    color: var(--ink-3);
  }

  .about p {
    margin-top: 18px;
    max-width: 30ch;
    color: var(--ink-2);
    font-size: 15px;
  }

  .col ul {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .col a {
    font-size: 15px;
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--fast) var(--ease);
  }

  .col a:hover {
    color: var(--ink);
  }

  .bottom {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--ink-3);
  }

  @media (max-width: 640px) {
    .top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 40px;
    }

    .about {
      grid-column: 1 / -1;
    }
  }
</style>
