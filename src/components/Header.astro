---
import { NAV } from "../data/site";

interface Props {
  variant?: "home" | "page";
}
const { variant = "page" } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header" data-variant={variant} data-header>
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Go to homepage" aria-current={path === "/" ? "page" : undefined}>
      <img src="/assets/digit-mark.svg" alt="" width="28" height="28" />
      <span class="brand-word">Digit <span>Software</span></span>
    </a>

    <nav class="primary" aria-label="Primary">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={item.href} class:list={[{ "is-active": isCurrent(item.href) }]} aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="sr-only" data-menu-label>Open navigation</span>
      <span class="bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="Mobile">
      <ul>
        {NAV.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
  }

  /* The glass lives on a pseudo-element: a backdrop-filter on the header itself would make it the containing
     block for the fixed mobile menu and collapse that panel to the header's height. */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-bottom: 1px solid transparent;
    transition: background 400ms var(--ease), border-color 400ms var(--ease);
  }

  /* Home: the header floats over the hero and only becomes glass after the page scrolls. */
  .site-header[data-variant="home"] {
    position: fixed;
    left: 0;
    right: 0;
  }

  .site-header[data-variant="page"]::before,
  .site-header.is-scrolled::before {
    background: rgba(3, 6, 14, 0.92);
    border-bottom-color: var(--line);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    backdrop-filter: blur(18px) saturate(140%);
  }

  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
    margin-right: auto;
    flex-shrink: 0;
  }

  .brand img {
    width: 28px;
    height: 28px;
  }

  .brand-word {
    font-size: 17px;
    font-weight: 650;
    font-stretch: 114%;
    letter-spacing: -0.02em;
  }

  .brand-word span {
    font-weight: 450;
    color: var(--ink-3);
  }

  .primary ul {
    display: flex;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .primary a {
    position: relative;
    display: block;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--fast) var(--ease), background var(--fast) var(--ease);
  }

  .primary a:hover {
    color: var(--ink);
    background: rgba(120, 170, 255, 0.07);
  }

  .primary a.is-active {
    color: var(--ink);
  }

  .primary a.is-active::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 1px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 10px var(--cyan);
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    margin-right: -8px;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
    border-radius: 12px;
    align-items: center;
    justify-content: center;
  }

  .bars {
    position: relative;
    width: 20px;
    height: 10px;
  }

  .bars i {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 320ms var(--ease), top 320ms var(--ease);
  }

  .bars i:first-child {
    top: 0;
  }

  .bars i:last-child {
    top: 8.5px;
  }

  .menu-toggle[aria-expanded="true"] .bars i:first-child {
    top: 4.25px;
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .bars i:last-child {
    top: 4.25px;
    transform: rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    z-index: 49;
    padding: 24px var(--gutter) calc(32px + env(safe-area-inset-bottom));
    background:
      radial-gradient(600px 400px at 80% 0%, rgba(39, 150, 255, 0.14), transparent 70%),
      var(--bg-0);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-menu li {
    border-bottom: 1px solid var(--line);
    animation: menu-in 520ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 40ms);
  }

  .mobile-menu a[aria-current="page"] {
    color: var(--cyan-hi);
  }

  .mobile-menu li a {
    display: block;
    padding: 16px 2px;
    font-size: 26px;
    font-weight: 520;
    font-stretch: 110%;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .mobile-foot {
    margin-top: auto;
    padding-top: 32px;
    text-decoration: none;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (max-width: 860px) {
    .primary {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }
  }

  :global(body.menu-open) .site-header::before {
    background: var(--bg-0);
    border-bottom-color: var(--line);
  }
</style>
