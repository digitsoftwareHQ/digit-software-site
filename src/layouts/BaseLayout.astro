---
import "@fontsource-variable/mona-sans/wdth.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import monaLatin from "@fontsource-variable/mona-sans/files/mona-sans-latin-wdth-normal.woff2?url";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  /** "home" renders the header transparent over the hero until the page scrolls. */
  variant?: "home" | "page";
}

const {
  title,
  description = SITE.description,
  path = "/",
  noindex = false,
  variant = "page",
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.tagline}`;
const canonical = new URL(path, SITE.url).toString();
const ogImage = new URL(SITE.ogImage, SITE.url).toString();

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.name,
  alternateName: "Digit",
  url: `${SITE.url}/`,
  logo: `${SITE.url}/assets/icon-192.png`,
  email: SITE.email,
  description: SITE.description,
};
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="theme-color" content="#02040a" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={monaLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/assets/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="shortcut icon" href="/assets/favicon.ico" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={SITE.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={SITE.ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(organization)} />

    <script is:inline>
      document.documentElement.classList.replace("no-js", "js");
    </script>
  </head>
  <body data-variant={variant}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header variant={variant} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
